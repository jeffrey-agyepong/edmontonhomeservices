---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingRow from '../../components/ListingRow.astro';
import Sponsors from '../../components/home/Sponsors.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sortListings } from '../../lib/sort';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const listings = await getCollection('listings');

  return categories.map((category) => ({
    params: { slug: category.id },
    props: {
      category,
      listings: sortListings(
        listings.filter((l) => l.data.category === category.id),
        'top',
      ),
    },
  }));
}

const { category, listings } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
---

<BaseLayout title={c.name} description={c.description}>
  <section
    class="full-bg bg-emerald-800 text-(--bg) px-4 py-8 sm:py-10 md:py-14 border-b-4 border-red-400"
  >
    <Breadcrumbs
      variant="hero"
      items={[
        { label: 'Home', href: base },
        { label: 'Categories', href: href('categories') },
        { label: c.name },
      ]}
    />
    <h1
      class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 sm:mb-4 text-center text-white"
    >
      {c.icon && <span class="category-icon" set:html={c.icon} />}
      {c.name}
    </h1>
    <p
      class="page-head-desc text-base sm:text-lg md:text-xl max-w-2xl flex justify-center mx-auto text-center text-white"
    >
      {
        c.description ||
          'Browse our complete directory of Edmonton home service professionals.'
      }
    </p>
  </section>

  <Sponsors categoryName={c.name} categoryId={category.id} />

  <section class="category-box category-box--wide my-8">
    <div class="category-sites">
      {
        listings.length === 0 ? (
          <p class="category-description">Nothing here yet.</p>
        ) : (
          listings.map((l, i) => <ListingRow listing={l} rank={i + 1} />)
        )
      }
    </div>
  </section>
</BaseLayout>
