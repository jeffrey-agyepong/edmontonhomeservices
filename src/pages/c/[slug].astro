---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sponsors from '../../components/home/Sponsors.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryListings from '../../components/category/CategoryListings.astro';
import { sortListings } from '../../lib/sort';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const listings = await getCollection('listings');

  return categories.map((category) => ({
    params: { slug: category.id },
    props: {
      category,
      listings: sortListings(
        listings.filter((l) => l.data.category === category.id),
        'top',
      ),
    },
  }));
}

const { category, listings } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// "in Edmonton" belongs on the title tag and H1 — the two places it
// actually earns local-SEO value — but not in the breadcrumb trail below,
// which stays a plain "Home > Categories > House Cleaning" path.
const categoryTitle = `${c.name} in Edmonton`;

// A real sentence that happens to mention Edmonton, not the category's
// raw description with "in Edmonton" appended onto the end of it.
const categoryMetaDescription = [
  `Find trusted ${c.name.toLowerCase()} services in Edmonton.`,
  c.description,
]
  .filter(Boolean)
  .join(' ');
---

<BaseLayout title={categoryTitle} description={categoryMetaDescription}>
  <PageHero
    title={categoryTitle}
    icon={c.icon}
    description={c.description ||
      'Browse our complete directory of Edmonton home service professionals.'}
    breadcrumbs={[
      { label: 'Home', href: base },
      { label: 'Categories', href: href('categories') },
      { label: c.name },
    ]}
    spaced={false}
  />

  <Sponsors categoryName={c.name} categoryId={category.id} />

  <section class="wrap my-8">
    <CategoryListings listings={listings} categoryName={c.name} />
  </section>
</BaseLayout>
