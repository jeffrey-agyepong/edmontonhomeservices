---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Edmonton Home Services."
>
  <PageHero
    title="Contact Us"
    description="Whether you have a question about a listing, need help claiming your profile, or want to partner with us, we'd love to hear from you."
    breadcrumbs={[{ label: 'Home', href: base }, { label: 'Contact' }]}
  />

  <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mx-auto mb-16">
    <div>
      <h2 class="text-3xl font-bold mb-4">How can we help?</h2>
      <p class="max-w-xl text-xl mb-8">
        Our team is based right here in Edmonton. Drop us a message using the
        form, or reach out directly using the information below.
      </p>

      <div class="flex flex-col items-start gap-6">
        <div class="flex items-start gap-4">
          <span
            class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-(--panel-head)"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--primary)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
          </span>
          <div>
            <h3 class="mt-0 mb-1 text-xl font-semibold text-(--text)">
              Email Support
            </h3>
            <p class="mt-0 mb-1">Typically responds within 24 hours.</p>
            <p class="mt-0 mb-0">
              <a
                href="mailto:info@edmontonhomeservices.com"
                class="text-(--primary) hover:opacity-80"
              >
                info@edmontonhomeservices.com
              </a>
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span
            class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-(--panel-head)"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--primary)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
          </span>
          <div>
            <h3 class="mt-0 mb-1 text-xl font-semibold text-(--text)">
              Phone Support
            </h3>
            <p class="mt-0 mb-1">Mon–Fri, 9am–5pm MST.</p>
            <p class="mt-0 mb-0">
              <a
                href="tel:+17809837309"
                class="text-(--primary) hover:opacity-80"
              >
                780-983-7309
              </a>
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span
            class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-(--panel-head)"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--primary)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </span>
          <div>
            <h3 class="mt-0 mb-1 text-xl font-semibold text-(--text)">
              Location
            </h3>
            <p class="mt-0 mb-0">Edmonton, Alberta and surrounding area.</p>
          </div>
        </div>
      </div>
    </div>
    <div>
      <div class="form-card">
        <h2 class="flex items-center gap-3">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--accent)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-6 h-6"
            aria-hidden="true"
          >
            <path
              d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path>
          </svg>Send a message
        </h2>

        <!-- Hidden form for Netlify build-time detection. Netlify unions
             this with the real form below by matching `name="contact"` —
             but only if every field name here actually matches a field
             down there. -->
        <form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
          <input type="text" name="name" />
          <input type="email" name="email" />
          <input type="text" name="topic" />
          <input name="bot-field" />
          <textarea name="message"></textarea>
        </form>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label
              >Don't fill this out if you're human: <input
                name="bot-field"
              /></label
            >
          </p>
          <label for="name"
            >Name
            <input
              type="text"
              name="name"
              id="name"
              placeholder="John Doe"
              pattern="[A-Za-z\s'\-]+"
              title="Letters only, please"
              required
            />
          </label>
          <p
            id="name-error"
            class="field-error mt-1 mb-0 text-sm hidden"
            style="color: var(--danger)"></p>

          <label for="email"
            >Email
            <input
              type="email"
              name="email"
              id="email"
              placeholder="john.doe@example.com"
              title="Enter a valid email address"
              required
            />
          </label>
          <p
            id="email-error"
            class="field-error mt-1 mb-0 text-sm hidden"
            style="color: var(--danger)"></p>

          <label for="topic"
            >Topic
            <select name="topic" id="topic">
              <option>Listing Support (Update or Claim)</option>
              <option>General Inquiry</option>
              <option>Partnership or Advertising</option>
              <option>Report an Issue</option>
            </select>
          </label>

          <label for="message"
            >Message
            <textarea
              name="message"
              id="message"
              rows="5"
              placeholder="Your message here..."
              required></textarea>
          </label>
          <p
            id="message-error"
            class="field-error mt-1 mb-0 text-sm hidden"
            style="color: var(--danger)"></p>

          <button type="submit" class="btn-accent text-white border-0 mt-2"
            >Send Message</button
          >
        </form>

        <p
          id="contact-form-error"
          class="mt-4 mb-0 text-sm hidden"
          role="status"
          aria-live="polite"
          style="color: var(--danger)"
        ></p>

        <!-- Inline success state, shown in place of the form after a
             successful submit -->
        <div id="contact-form-success" class="hidden">
          <div
            class="bg-(--primary)/10 border-(--primary)/20 mb-6 flex h-16 w-16 items-center justify-center rounded-full border"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--primary)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-bold">Thanks, your message is in.</h3>
          <p class="text-(--text-dim)">
            We've received your message and will reply within 24 hours.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { validateForm, clearFieldErrorOnInput } from '../lib/form-errors';

  const form = document.getElementById(
    'contact-form',
  ) as HTMLFormElement | null;
  const errorMessage = document.getElementById('contact-form-error');
  const successState = document.getElementById('contact-form-success');

  form
    ?.querySelectorAll('input, select, textarea')
    .forEach((field) =>
      clearFieldErrorOnInput(
        field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      ),
    );

  function showError(message: string) {
    if (!errorMessage) return;
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.add('hidden');

    if (!validateForm(form)) return;

    const submitButton = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;

    try {
      const response = await fetch(window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(
          new FormData(form) as unknown as Record<string, string>,
        ).toString(),
      });

      if (!response.ok) {
        throw new Error(`Netlify Forms responded with ${response.status}`);
      }

      form.classList.add('hidden');
      successState?.classList.remove('hidden');
    } catch (error) {
      console.error('Contact form submission failed:', error);
      // A TypeError here (as opposed to the explicit Error thrown above
      // for a non-OK response) means fetch() itself never got a response
      // at all — no network connection, DNS failure, etc. — a different
      // situation from "the server said no" and worth telling visitors
      // apart from a generic failure.
      if (error instanceof TypeError) {
        showError(
          "Couldn't reach the server. Check your connection and try again.",
        );
      } else {
        showError(
          'Something went wrong sending your message. Please try again, or email us directly at info@edmontonhomeservices.com.',
        );
      }
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
