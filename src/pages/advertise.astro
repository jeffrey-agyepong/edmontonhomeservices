---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/home/FAQ.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL;

interface Feature {
  label: string;
  included?: boolean;
}

interface Tier {
  name: string;
  price: string;
  priceNote?: string;
  description: string;
  features: Feature[];
  cta: string;
  href: string;
  highlight?: boolean;
}

const tiers: Tier[] = [
  {
    name: 'Basic Listing',
    price: 'Free',
    description: 'Forever free, no credit card required.',
    features: [
      { label: 'Standard directory listing', included: true },
      { label: '1 Profile photo', included: true },
      { label: 'Phone number & address', included: true },
      { label: 'Website link', included: true },
    ],
    cta: 'Get Started for Free',
    href: '/submit-business',
  },
  {
    name: 'Premium Partner',
    price: '$50',
    priceNote: '/month',
    description: 'Stand out and generate direct leads.',
    features: [
      { label: 'Top-placement Featured Card', included: true },
      { label: 'Direct quote request form', included: true },
      { label: 'Full photo gallery (up to 10 images)', included: true },
      { label: '"Edmonton Verified" Trust Badge', included: true },
      { label: 'Dofollow website link', included: true },
      { label: 'Custom "Why Choose Us" section', included: true },
    ],
    cta: 'Upgrade to Premium',
    href: '/contact',
    highlight: true,
  },
  {
    name: 'Growth + Web Design',
    price: 'Custom',
    description: 'For businesses needing a total digital overhaul.',
    features: [
      { label: 'Everything in Premium Partner', included: true },
      { label: 'Custom Website Design & Dev', included: true },
      { label: 'Basic Local SEO Setup', included: true },
      { label: 'Mobile-responsive & fast', included: true },
      { label: 'Google Business Profile optimization', included: true },
    ],
    cta: 'Contact for a Quote',
    href: '/contact',
  },
];

const advertiseFaqs = [
  {
    question: 'How do you vet businesses?',
    answer:
      "Every business is reviewed by a real person before it's listed, not pulled in bulk. We note licensing and insurance where a business makes that information public — we don't independently verify it against a licensing body — and approval is a manual decision, not an automated one based on a review-score cutoff.",
  },
  {
    question: 'What is included in the Web Design tier?',
    answer:
      "Our Web Design tier, built by J.A Web Design, includes a fully custom, responsive website tailored to your brand, complete with foundational SEO to help you rank locally in Edmonton. It's the perfect solution if your current site is outdated or you're starting fresh.",
  },
];
---

<BaseLayout
  title="Advertise"
  description="Grow your local business with an Edmonton Home Services listing — from a free community listing to a complete digital overhaul."
>
  <PageHero
    title="Grow your local business."
    description="Join Edmonton's most trusted home services directory. Claim your existing listing or create a new one, from a free community listing to a complete digital overhaul."
    breadcrumbs={[{ label: 'Home', href: base }, { label: 'Advertise' }]}
  />

  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch mb-16">
    {
      tiers.map((tier) => (
        <div
          class={`relative flex h-full flex-col rounded-xl border p-6 shadow-lg ${
            tier.highlight
              ? 'border-2 border-[var(--accent)] bg-(--bg)'
              : 'border-(--line) bg-(--bg)'
          }`}
        >
          {tier.highlight && (
            <span class="badge-premium absolute -top-3 left-1/2 -translate-x-1/2">
              Most Popular
            </span>
          )}
          <h2 class="text-xl font-bold text-(--text)">{tier.name}</h2>
          <p class="mt-2 flex items-baseline gap-1">
            <span class="text-3xl font-bold text-(--heading)">
              {tier.price}
            </span>
            {tier.priceNote && (
              <span class="text-sm text-(--text-dim)">{tier.priceNote}</span>
            )}
          </p>
          <p class="mt-2 text-sm text-(--text-dim)">{tier.description}</p>

          <ul class="mt-5 flex flex-1 flex-col gap-3">
            {tier.features.map((feature) => (
              <li
                class={`flex items-start gap-2.5 text-sm ${
                  feature.included === false
                    ? 'text-(--text-dim) opacity-60'
                    : 'text-(--text)'
                }`}
              >
                {feature.included === false ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5 flex-none"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18M6 6l12 12" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--primary)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5 flex-none"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                )}
                <span>{feature.label}</span>
              </li>
            ))}
          </ul>

          <a
            href={tier.href}
            class={`mt-6 block rounded-lg py-2.5 text-center text-sm font-semibold no-underline ${
              tier.highlight
                ? 'bg-(--accent) text-white hover:opacity-90'
                : 'bg-(--panel-head) text-(--text) hover:bg-(--panel-hover)'
            }`}
          >
            {tier.cta}
          </a>
        </div>
      ))
    }
  </section>

  <FAQ
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about advertising with Edmonton Home Services."
    faqs={advertiseFaqs}
    collapsible={false}
  />
</BaseLayout>
