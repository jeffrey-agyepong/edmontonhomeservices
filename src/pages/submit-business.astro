---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getPopulatedCategories } from '../lib/categories';

const categories = (await getPopulatedCategories()).map((c) => c.category);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Submit Your Business"
  description="List your Edmonton home service business in our directory."
>
  <PageHero
    title="Submit Your Business"
    description="Get your business listed in front of Edmonton homeowners looking for trusted local pros. Fill out the form below and we'll review your submission."
    breadcrumbs={[
      { label: 'Home', href: base },
      { label: 'Submit Your Business' },
    ]}
  />

  <section class="max-w-2xl mx-auto mb-16">
    <div class="form-card">
      <h2 class="flex items-center gap-3">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--accent)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"></path>
        </svg>Business details
      </h2>

      <form
        id="submit-business-form"
        onsubmit="event.preventDefault()"
        novalidate
      >
        <label for="business-name"
          >Business Name
          <input
            type="text"
            name="business-name"
            id="business-name"
            placeholder="Acme Plumbing"
            required
          />
        </label>
        <p
          id="business-name-error"
          class="field-error mt-1 mb-0 text-sm hidden"
          style="color: var(--danger)"></p>

        <label for="category"
          >Category
          <select name="category" id="category" required>
            <option value="" selected disabled>Select a category</option>
            {categories.map((c) => <option value={c.id}>{c.data.name}</option>)}
          </select>
        </label>
        <p
          id="category-error"
          class="field-error mt-1 mb-0 text-sm hidden"
          style="color: var(--danger)"></p>

        <div class="form-row">
          <label for="phone"
            >Phone
            <input
              type="tel"
              name="phone"
              id="phone"
              placeholder="780-555-0123"
              pattern="[0-9+\(\)\-. ]+"
              title="Numbers only, e.g. 780-555-0123"
              required
            />
          </label>

          <label for="website"
            >Website
            <input
              type="text"
              name="website"
              id="website"
              placeholder="https://example.com"
              pattern="(https?://)?([-\w]+\.)+[a-zA-Z]{2,}(/\S*)?"
              title="Enter a domain, e.g. example.com or https://example.com"
            />
          </label>
        </div>
        <div class="form-row">
          <p
            id="phone-error"
            class="field-error mt-1 mb-0 text-sm hidden"
            style="color: var(--danger)"></p>
          <p
            id="website-error"
            class="field-error mt-1 mb-0 text-sm hidden"
            style="color: var(--danger)"></p>
        </div>

        <label for="neighborhood"
          >Neighborhood / Service Area
          <input
            type="text"
            name="neighborhood"
            id="neighborhood"
            placeholder="e.g. Strathcona, or 'all of Edmonton'"
          />
        </label>

        <label for="description"
          >Tell us about the business
          <textarea
            name="description"
            id="description"
            rows="5"
            placeholder="Services offered, years in business, what makes you stand out..."
            required></textarea>
        </label>
        <p
          id="description-error"
          class="field-error mt-1 mb-0 text-sm hidden"
          style="color: var(--danger)"></p>

        <button
          type="submit"
          id="submit-business-button"
          class="btn-accent text-white border-0 mt-2"
        >
          Submit Business
        </button>
      </form>

      <p
        id="submit-business-error"
        class="mt-4 mb-0 text-sm hidden"
        role="status"
        aria-live="polite"
        style="color: var(--danger)"
      />

      <!-- Inline success state, shown in place of the form after a
           successful submit -->
      <div id="submit-business-success" class="hidden">
        <div
          class="bg-(--primary)/10 border-(--primary)/20 mb-6 flex h-16 w-16 items-center justify-center rounded-full border"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--primary)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-bold">Thanks, your listing is in.</h3>
        <p class="text-(--text-dim)">
          Your listing is being reviewed and will appear on the site once
          approved.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { validateForm, clearFieldErrorOnInput } from '../lib/form-errors';

  const form = document.getElementById(
    'submit-business-form',
  ) as HTMLFormElement;
  const submitButton = document.getElementById(
    'submit-business-button',
  ) as HTMLButtonElement;
  const errorMessage = document.getElementById(
    'submit-business-error',
  ) as HTMLParagraphElement;
  const successState = document.getElementById('submit-business-success');

  form
    .querySelectorAll('input, select, textarea')
    .forEach((field) =>
      clearFieldErrorOnInput(
        field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      ),
    );

  function showError(message: string) {
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage.classList.add('hidden');

    if (!validateForm(form)) return;

    const formData = new FormData(form);

    submitButton.disabled = true;
    const originalLabel = submitButton.textContent;
    submitButton.textContent = 'Submitting…';

    // Loaded dynamically, not as a static top-level import: if this
    // module fails to load (a stale dev-server dependency cache, a
    // blocked script, etc.), a static import would have silently broken
    // this entire file before the submit listener above ever attached —
    // the button would just do nothing, with no way to tell the visitor
    // why. A dynamic import lets that failure be caught and shown instead.
    let supabase;
    try {
      const { createSupabaseBrowserClient } = await import(
        '../lib/supabase-browser'
      );
      supabase = createSupabaseBrowserClient();
    } catch (moduleError) {
      console.error('Failed to load the Supabase client:', moduleError);
      submitButton.disabled = false;
      submitButton.textContent = originalLabel;
      showError(
        "Couldn't load the submission form. Please refresh the page and try again, or contact us directly.",
      );
      return;
    }

    // Deliberately no `approved` or `premium` here at all — this client
    // never decides its own trust status. The businesses table's
    // "Public can submit a pending business" insert policy is what
    // actually enforces approved = false (and premium = false), whether
    // this form sends nothing for them (defaults apply) or someone
    // skips this form and calls the API directly.
    const { error } = await supabase.from('businesses').insert({
      name: formData.get('business-name')?.toString().trim(),
      category: formData.get('category')?.toString() || null,
      phone: formData.get('phone')?.toString().trim() || null,
      website: formData.get('website')?.toString().trim() || null,
      neighborhood: formData.get('neighborhood')?.toString().trim() || null,
      description: formData.get('description')?.toString().trim() || null,
    });

    submitButton.disabled = false;
    submitButton.textContent = originalLabel;

    if (error) {
      // Postgres error code 42501 = insufficient_privilege, which is what
      // a row-level security policy rejection surfaces as — a different,
      // more actionable situation for the visitor than a generic failure.
      if (error.code === '42501') {
        showError(
          "We couldn't save your listing due to a permissions issue on our end. Please contact us directly so we can help.",
        );
      } else {
        showError(`Couldn't submit your business: ${error.message}`);
      }
    } else {
      form.classList.add('hidden');
      successState?.classList.remove('hidden');
    }
  });
</script>
