---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TwoColumn from '../components/about/TwoColumn.astro';

const base = import.meta.env.BASE_URL;
const about = await getEntry('about', 'about');
const data = about!.data;
---

<BaseLayout
  title="About"
  description="Learn more about Edmonton Home Services."
>
  <PageHero
    title={data.heroTitle}
    description={data.heroDescription}
    breadcrumbs={[{ label: 'Home', href: base }, { label: 'About' }]}
  />
  <TwoColumn
    badgeLabel={data.badgeLabel}
    heading={data.sectionHeading}
    paragraph1={data.paragraph1}
    paragraph2={data.paragraph2}
    imageUrl={data.imageUrl}
    statPercent={data.statPercent}
    statCaption={data.statCaption}
  />
</BaseLayout>
