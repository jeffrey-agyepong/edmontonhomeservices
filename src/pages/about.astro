---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn more about Edmonton Home Services."
>
  <section
    class="full-bg bg-emerald-800 text-(--bg) px-4 py-8 sm:py-10 md:py-14 mb-10 sm:mb-16 border-b-4 border-red-400"
  >
    <h1
      class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 sm:mb-4 flex justify-center text-white"
    >
      About Us
    </h1>
    <p
      class="page-head-desc text-base sm:text-lg md:text-xl max-w-2xl flex justify-center mx-auto text-center text-white"
    >
      Whether you have a question about a listing, need help claiming your
      profile, or want to partner with us, we'd love to hear from you.
    </p>
  </section>
</BaseLayout>
