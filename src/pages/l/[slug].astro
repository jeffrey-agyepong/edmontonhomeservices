---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/Rating.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { COUNT_CLICKS } from '../../consts';
import { placeholderGradient } from '../../lib/placeholder';
import { createSupabaseAnonClient } from '../../lib/supabase-anon';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  const categories = await getCollection('categories');

  // One query for every listing's matching businesses row (joined by
  // slug — see supabase/001_businesses_slug_and_backfill.sql), rather than
  // one query per listing. Powers the "Claim This Listing" button below:
  // a null owner_id means unclaimed, and businessId is what a submitted
  // claim_requests row points at. A listing with no matching row at all
  // (not yet backfilled) just won't show the button — see the Astro
  // template below.
  //
  // Wrapped in try/catch deliberately: this runs during the build's static
  // prerendering step, not per-request, so an unhandled throw here doesn't
  // just break this one feature — it fails `astro build` outright and takes
  // every page on the site down with it (this is exactly what happened when
  // PUBLIC_SUPABASE_URL wasn't set in Netlify's build environment;
  // createClient() throws synchronously before any network call is even
  // made). "Claim This Listing" is supplementary to the listing pages
  // themselves, so any failure here — missing env vars, Supabase down, a
  // network hiccup — should degrade to "button doesn't show anywhere," the
  // same behavior as a listing simply having no matching businesses row,
  // never take down the build.
  let businessBySlug = new Map<string, { id: number; owner_id: string | null }>();
  try {
    const supabase = createSupabaseAnonClient();
    const { data: businesses, error } = await supabase
      .from('businesses')
      .select('id, owner_id, slug')
      .not('slug', 'is', null);
    if (error) throw error;
    businessBySlug = new Map((businesses ?? []).map((b) => [b.slug, b]));
  } catch (err) {
    console.warn(
      '[l/[slug]] Skipping "Claim This Listing" for this build — could not read businesses from Supabase:',
      err instanceof Error ? err.message : err,
    );
  }

  return listings.map((listing) => {
    const business = businessBySlug.get(listing.id);
    return {
      params: { slug: listing.id },
      props: {
        listing,
        category: categories.find((c) => c.id === listing.data.category) ?? null,
        businessId: business?.id ?? null,
        ownerId: business?.owner_id ?? null,
      },
    };
  });
}

const { listing, category, businessId, ownerId } = Astro.props;
const d = listing.data;
const base = import.meta.env.BASE_URL;

const categoriesHref = `${base}categories`.replace(/\/+/g, '/');
const categoryHref = category
  ? `${base}c/${category.id}`.replace(/\/+/g, '/')
  : categoriesHref;

const host = (() => {
  try {
    return new URL(d.website).host.replace(/^www\./, '');
  } catch {
    return d.website;
  }
})();

const visitHref = COUNT_CLICKS
  ? `${import.meta.env.DIRECTORY_API?.replace(/\/+$/, '')}/visit/${listing.id}`
  : d.website;

// Premium Partner tier feature (see /advertise) — non-premium outbound links
// stay nofollow.
const websiteRel = d.premium ? 'noopener' : 'nofollow noopener';

const telHref = d.phone ? `tel:${d.phone.replace(/[^\d+]/g, '')}` : null;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: d.name,
  url: d.website,
  ...(d.description ? { description: d.description } : {}),
  ...(d.phone ? { telephone: d.phone } : {}),
  ...(d.address ? { address: d.address } : {}),
};

/*
 * Premium listings get a photo gallery: real `gallery` photos if the
 * business has supplied any (via Keystatic), otherwise a deterministic
 * placeholder gradient per listing. The placeholder is never presented as
 * a real photo.
 */
const galleryStyles =
  d.premium && d.gallery.length === 0
    ? [0, 1, 2].map((i) => placeholderGradient(listing.id, i))
    : [];

// Real neighborhood only, no generic "in Edmonton" filler when a listing
// doesn't have one on file — most don't yet, so this is plain d.name for
// most listings today.
const listingTitle = d.neighborhood ? `${d.name} in ${d.neighborhood}` : d.name;
---

<BaseLayout title={listingTitle} description={d.description}>
  <div class="listing-page">
    <Breadcrumbs
      bar
      items={[
        { label: 'Home', href: base },
        { label: 'Categories', href: categoriesHref },
        ...(category
          ? [{ label: category.data.name, href: categoryHref }]
          : []),
        { label: d.name },
      ]}
    />

    <article class="listing-detail">
      {
        d.premium && d.gallery.length > 0 && (
          <div class="listing-gallery">
            {d.gallery.map((src) => (
              <img
                class="listing-gallery-item"
                src={src}
                alt={d.name}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        )
      }

      {
        d.premium && d.gallery.length === 0 && (
          <div class="listing-gallery">
            {galleryStyles.map((style) => (
              <div class="listing-gallery-item" style={`background:${style}`} />
            ))}
          </div>
        )
      }

      {
        !d.premium && d.photo && (
          <div class="listing-photo-single">
            <img src={d.photo} alt={d.name} loading="lazy" decoding="async" />
          </div>
        )
      }

      {
        !d.premium && !d.photo && (
          <div class="listing-photo-single">
            <div
              class="listing-photo-single-placeholder"
              style={`background:${placeholderGradient(listing.id)}`}
            >
              <span>{d.name.charAt(0)}</span>
            </div>
          </div>
        )
      }

      <div class="flex flex-wrap items-center gap-2 mb-2">
        {category && <span class="service-chip">{category.data.name}</span>}
        {d.premium && <span class="badge-verified">&#10003; Verified</span>}
      </div>

      <div class="listing-head">
        {
          d.photo && (
            <img
              class="listing-favicon"
              src={d.photo}
              alt=""
              width="48"
              height="48"
              decoding="async"
            />
          )
        }
        <div class="listing-head-text">
          <h1>{listingTitle}</h1>
        </div>
      </div>

      {d.description && <p class="page-head-desc">{d.description}</p>}

      <div
        class="flex flex-wrap items-center gap-4 text-sm text-(--text-dim) mt-2 mb-4"
      >
        {d.premium && <span>&#10003; Edmonton Verified</span>}
        {
          d.google_rating !== null && (
            <Rating
              rating={d.google_rating}
              count={d.google_review_count}
              showCount={true}
            />
          )
        }
        {
          d.years_in_business !== null && (
            <span>{d.years_in_business} Years in Business</span>
          )
        }
      </div>

      <div class="listing-columns">
        <div class="listing-main">
          {
            d.services.length > 0 && (
              <div class="mb-4">
                <h2 class="section-heading">Services Offered</h2>
                <ul class="service-chips">
                  {d.services.map((s) => (
                    <li class="service-chip">{s}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            d.premium && d.why_choose_us && (
              <div class="form-card mb-4">
                <h2 class="section-heading mt-0">Why Choose Us</h2>
                <p class="text-(--text-dim) m-0">{d.why_choose_us}</p>
              </div>
            )
          }

          <p class="listing-actions">
            <a
              class="btn-primary"
              href={visitHref}
              target="_blank"
              rel={websiteRel}
            >
              Visit {host}
              <svg
                class="arrow"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
                ><path d="M13.2 5.6 11.8 7l4 4H4v2h11.8l-4 4 1.4 1.4L19.6 12z"
                ></path></svg
              >
            </a>
          </p>

          {
            d.premium && (
              <section class="quote-section" id="quote">
                <h2 class="quote-heading">Request a Quote from {d.name}</h2>
                <p class="section-note">
                  Send a message directly to {d.name}. They typically respond
                  quickly.
                </p>
                <form class="coming-soon-form" data-coming-soon>
                  <div class="form-row">
                    <label>
                      First Name
                      <input
                        type="text"
                        name="first_name"
                        autocomplete="given-name"
                        placeholder="Jane"
                        required
                      />
                    </label>
                    <label>
                      Last Name
                      <input
                        type="text"
                        name="last_name"
                        autocomplete="family-name"
                        placeholder="Doe"
                        required
                      />
                    </label>
                  </div>
                  <div class="form-row">
                    <label>
                      Email
                      <input
                        type="email"
                        name="email"
                        autocomplete="email"
                        placeholder="jane@example.com"
                        required
                      />
                    </label>
                    <label>
                      Phone Number
                      <input
                        type="tel"
                        name="phone"
                        autocomplete="tel"
                        placeholder="(780) 555-0123"
                      />
                    </label>
                  </div>
                  <label>
                    Message / Project Details
                    <textarea
                      name="message"
                      rows="4"
                      placeholder="Tell us about what you need help with..."
                      required
                    />
                  </label>
                  <button
                    type="submit"
                    class="btn-accent text-white inline-block w-auto"
                  >
                    Send Request
                  </button>
                  <p class="coming-soon-note" hidden>
                    Quote requests aren't live yet — check back soon.
                  </p>
                </form>
              </section>
            )
          }
        </div>

        <aside class="listing-sidebar">
          <div class="form-card">
            <h2 class="section-heading mt-0">Contact &amp; Hours</h2>
            <ul class="listing-facts">
              {
                d.phone && (
                  <li>
                    <strong>Phone:</strong> <a href={telHref}>{d.phone}</a>
                  </li>
                )
              }
              {
                d.email && (
                  <li>
                    <strong>Email:</strong>{' '}
                    <a href={`mailto:${d.email}`}>{d.email}</a>
                  </li>
                )
              }
              <li>
                <strong>Website:</strong>{' '}
                <a href={visitHref} target="_blank" rel={websiteRel}>
                  {host}
                </a>
              </li>
              {
                d.hours && (
                  <li>
                    <strong>Hours:</strong> {d.hours}
                  </li>
                )
              }
              {
                d.neighborhood && (
                  <li>
                    <strong>Service area:</strong> {d.neighborhood}
                  </li>
                )
              }
              {
                d.address && (
                  <li>
                    <strong>Address:</strong> {d.address}
                  </li>
                )
              }
              {
                d.years_in_business !== null && (
                  <li>
                    <strong>Years in business:</strong> {d.years_in_business}
                  </li>
                )
              }
              {
                d.licensed_insured && (
                  <li>
                    <strong>Licensed &amp; insured</strong> (self-reported)
                  </li>
                )
              }
            </ul>

            {
              d.premium && (
                <>
                  <a class="btn-accent text-white w-full mt-2" href="#quote">
                    Request a Quote
                  </a>
                  <p class="hint mt-2 mb-0 text-center">
                    Typically responds quickly
                  </p>
                </>
              )
            }
          </div>

          {
            businessId && !ownerId && (
              <div
                class="form-card claim-card mt-4"
                data-business-id={businessId}
              >
                <div class="claim-prompt">
                  <h2 class="section-heading mt-0">Own this business?</h2>
                  <p class="section-note mb-3">
                    Claim this listing to manage its details going forward.
                  </p>
                  <button
                    type="button"
                    id="claim-button"
                    class="btn-secondary w-full"
                  >
                    Claim This Listing
                  </button>
                </div>

                <form
                  id="claim-form"
                  class="hidden"
                  onsubmit="event.preventDefault()"
                  novalidate
                >
                  <label for="claim-message">
                    Message (optional)
                    <textarea
                      name="message"
                      id="claim-message"
                      rows="3"
                      placeholder="I'm the owner, here's my phone number for verification..."
                    />
                  </label>
                  <button
                    type="submit"
                    id="claim-submit"
                    class="btn-accent text-white border-0 w-full"
                  >
                    Submit Claim Request
                  </button>
                  <p
                    id="claim-error"
                    class="mt-2 mb-0 text-sm hidden"
                    style="color: var(--danger)"
                  />
                </form>

                <p
                  id="claim-success"
                  class="hidden m-0 text-sm"
                  style="color: var(--primary)"
                  role="status"
                  aria-live="polite"
                >
                  Thanks, we'll review your request and follow up by email.
                </p>
              </div>
            )
          }
        </aside>
      </div>
    </article>

    <section class="reviews-section">
      <h2 class="reviews-heading">Reviews &amp; Testimonials</h2>

      {
        d.google_rating !== null && (
          <p class="mb-2">
            <Rating
              rating={d.google_rating}
              count={d.google_review_count}
              showCount={true}
            />
          </p>
        )
      }

      {
        d.reviews.some((r) => r.text.startsWith('PLACEHOLDER')) && (
          <p class="hint mb-2">
            ⚠ Preview data — the reviews below are placeholders, not real
            customer feedback.
          </p>
        )
      }

      {
        d.reviews.length > 0 ? (
          <div class="flex flex-col gap-3">
            {d.reviews.map((r) => (
              <article class="review-card">
                <div class="flex items-center justify-between gap-2">
                  <strong>{r.name}</strong>
                  <Rating rating={r.rating} />
                </div>
                {r.location && <p class="hint mt-1 mb-2">{r.location}</p>}
                <p class="m-0">&ldquo;{r.text}&rdquo;</p>
              </article>
            ))}
          </div>
        ) : (
          <p class="section-note">
            Written by the community, not {d.name} — no reviews yet, be the
            first to leave one.
          </p>
        )
      }
    </section>

    <section class="reviews-section">
      <h2 class="reviews-heading">Write a Review</h2>
      <p class="section-note">Share your own experience with {d.name}.</p>

      <form class="coming-soon-form review-form" data-coming-soon>
        <label>
          Your name
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Jane Doe"
            required
          />
        </label>
        <label>
          Rating
          <select name="rating" required>
            <option value="">Select a rating</option>
            <option value="5">5 — Excellent</option>
            <option value="4">4 — Good</option>
            <option value="3">3 — Average</option>
            <option value="2">2 — Below average</option>
            <option value="1">1 — Poor</option>
          </select>
        </label>
        <label>
          Your review
          <textarea
            name="review"
            rows="3"
            placeholder="Share your experience with this business..."
            required></textarea>
        </label>
        <button type="submit" class="btn-primary">Submit Review</button>
        <p class="coming-soon-note" hidden>
          Reviews aren't live yet — check back soon.
        </p>
      </form>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <script>
    // No backend yet — surface a clear "coming soon" message instead of
    // silently doing nothing or submitting somewhere that doesn't exist.
    document
      .querySelectorAll<HTMLFormElement>('[data-coming-soon]')
      .forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.querySelector('.coming-soon-note')?.removeAttribute('hidden');
        });
      });

    // ------------------------------------------------------------- claim
    const claimCard = document.querySelector<HTMLElement>('.claim-card');
    if (claimCard) {
      const businessId = claimCard.dataset.businessId as string;
      const claimButton = document.getElementById('claim-button');
      const claimPrompt = claimCard.querySelector<HTMLElement>('.claim-prompt');
      const claimForm = document.getElementById(
        'claim-form',
      ) as HTMLFormElement | null;
      const claimSubmit = document.getElementById(
        'claim-submit',
      ) as HTMLButtonElement | null;
      const claimError = document.getElementById(
        'claim-error',
      ) as HTMLParagraphElement | null;
      const claimSuccess = document.getElementById('claim-success');
      const base = import.meta.env.BASE_URL;

      // Loaded lazily, same reasoning as the dashboard and login pages: a
      // static top-level import would break this whole script if the
      // module fails to load, taking the button down with it.
      async function getSupabase() {
        const { createSupabaseBrowserClient } = await import(
          '../../lib/supabase-browser'
        );
        return createSupabaseBrowserClient();
      }

      claimButton?.addEventListener('click', async () => {
        let supabase;
        try {
          supabase = await getSupabase();
        } catch (moduleError) {
          console.error('Failed to load the Supabase client:', moduleError);
          return;
        }

        const {
          data: { session },
        } = await supabase.auth.getSession();

        if (!session) {
          window.location.href = `${base}login`.replace(/\/+/g, '/');
          return;
        }

        claimPrompt?.classList.add('hidden');
        claimForm?.classList.remove('hidden');
      });

      claimForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!claimSubmit) return;
        claimError?.classList.add('hidden');

        const message = (
          new FormData(claimForm).get('message')?.toString() ?? ''
        ).trim();

        claimSubmit.disabled = true;
        const originalLabel = claimSubmit.textContent;
        claimSubmit.textContent = 'Submitting…';

        let supabase;
        try {
          supabase = await getSupabase();
        } catch (moduleError) {
          console.error('Failed to load the Supabase client:', moduleError);
          claimSubmit.disabled = false;
          claimSubmit.textContent = originalLabel;
          if (claimError) {
            claimError.textContent =
              "Couldn't load the claim form. Please refresh the page and try again.";
            claimError.classList.remove('hidden');
          }
          return;
        }

        const {
          data: { session },
        } = await supabase.auth.getSession();

        if (!session) {
          window.location.href = `${base}login`.replace(/\/+/g, '/');
          return;
        }

        // No `status` sent — the column default and the insert policy's
        // WITH CHECK both land on 'pending' regardless, same
        // defense-in-depth pattern as businesses.approved/premium.
        const { error } = await supabase.from('claim_requests').insert({
          business_id: businessId,
          user_id: session.user.id,
          message: message || null,
        });

        claimSubmit.disabled = false;
        claimSubmit.textContent = originalLabel;

        if (error) {
          if (claimError) {
            claimError.textContent = `Couldn't submit your claim request: ${error.message}`;
            claimError.classList.remove('hidden');
          }
        } else {
          claimForm.classList.add('hidden');
          claimSuccess?.classList.remove('hidden');
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 9999px;
    padding: 3px 10px;
  }

  .listing-columns {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
    align-items: start;
  }

  /* .form-card is normally a centred, width-capped standalone form (see
     contact.astro) — here it's reused just for its panel look, so it needs
     to fill its grid column instead. */
  .listing-sidebar .form-card {
    max-width: none;
    margin: 0;
  }

  /* Stays in view as the left column scrolls past Why Choose Us/Services, so
     it ends up sitting next to the Request a Quote form lower down instead
     of being left behind at the top. */
  .listing-sidebar {
    position: sticky;
    top: 90px;
  }

  /* Basic Listing tier only includes 1 profile photo (see /advertise) — a
     single modest photo, not the premium multi-photo gallery collage. */
  .listing-photo-single {
    margin: 0 0 16px;
  }
  .listing-photo-single img,
  .listing-photo-single-placeholder {
    display: block;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }
  .listing-photo-single-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .listing-photo-single-placeholder span {
    font-size: 2.5rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.9);
  }

  .review-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
  }

  @media (max-width: 760px) {
    .listing-columns {
      grid-template-columns: 1fr;
    }
    .listing-sidebar {
      position: static;
    }
  }
</style>
