---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryBox from "../components/CategoryBox.astro";
import { sortListings } from "../lib/sort";
import { SITE_TITLE, SITE_TAGLINE, PER_CATEGORY } from "../consts";
import Hero from "../components/home/Hero.astro";
import Category from "../components/home/Category.astro";

const listings = await getCollection("listings");
const categories = (await getCollection("categories")).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

// A box per category, skipping empty ones — an empty box helps nobody.
const sections = categories
  .map((category) => {
    const mine = sortListings(
      listings.filter((l) => l.data.category === category.data.slug),
      "top",
    );
    return {
      category,
      listings: mine.slice(0, PER_CATEGORY),
      total: mine.length,
    };
  })
  .filter((s) => s.total > 0);
---

<BaseLayout>
  <div class="landing-header">
    <!-- <h1>{SITE_TITLE}</h1>
    <p class="landing-tagline">{SITE_TAGLINE}</p> -->

    <Hero />
   
    <!-- <p class="landing-meta">
      {listings.length} listings in {sections.length} categories
    </p> -->
  </div>
 <Category/>
  {
    sections.length === 0 ? (
      <p class="landing-meta">
        Nothing here yet. Add JSON files under{" "}
        <code>src/content/listings/</code>.
      </p>
    ) : (
      <div class="category-grid" id="categories">
        {sections.map((s) => (
          <CategoryBox
            category={s.category}
            listings={s.listings}
            total={s.total}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
