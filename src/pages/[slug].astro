---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * The editable pages — about, privacy, terms.
 *
 * This route is last in Astro's matching order, so /c/… and /l/… still win.
 * Bodies are HTML written in the directory's own admin, so they are rendered
 * unescaped; treat the API you build against as trusted, because it is the
 * same content the PHP site outputs.
 */
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// First sentence of the body, tags stripped, as the meta description.
const description = page.data.body
  .replace(/<[^>]+>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);
---

<BaseLayout title={page.data.title} description={description}>
  <article class="page-body">
    <h1>{page.data.title}</h1>
    <Fragment set:html={page.data.body} />
  </article>
</BaseLayout>
