---
// This page must run on demand, not be baked into a static HTML file at
// build time — otherwise middleware.ts's session check never gets a
// chance to run before the page is served, and the auth gate does
// nothing. See the comment block at the top of middleware.ts.
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase-server';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/+/g, '/');

// middleware.ts already ran for this request: it looked up the session,
// redirected to /login if there wasn't one, and — only once it confirmed
// a real user — attached that user to Astro.locals before letting the
// request continue here. So by the time this line runs, a redirect has
// already happened for anyone who isn't logged in, and `user` is
// guaranteed to be set.
const { user } = Astro.locals;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// One business per account, matched by owner_id against this user's
// Supabase auth ID. maybeSingle() (not single()) is deliberate — a brand
// new account with nothing linked yet is a normal, expected result (zero
// rows), not an error. `error` here means something actually went wrong
// (bad query, blocked by a row-level security policy, etc.), which is a
// different situation from "no business yet" and gets its own message
// below rather than being lumped in with it. `id` is now selected too —
// the edit form needs it for the update()'s .eq('id', ...) below.
// `approved` drives the fourth (pending-review) state below.
const { data: business, error } = await supabase
  .from('businesses')
  .select(
    'id, owner_id, name, category, neighborhood, phone, website, description, hours, years_in_business, licensed_insured, approved',
  )
  .eq('owner_id', user!.id)
  .maybeSingle();

// Same slug -> display-name source every category page on the site
// already uses (see c/[slug].astro, submit-business.astro's own category
// <select>). Deliberately NOT getPopulatedCategories() from
// lib/categories.ts — that helper filters out any category with zero
// listings in the Astro content collection, which has nothing to do with
// whether it's a valid category for a Supabase business to belong to. A
// business's current category could end up filtered out of its own
// dropdown. This pulls the full, unfiltered list instead, sorted the same
// way that helper sorts it (admin order, then name).
const allCategories = (await getCollection('categories')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

const categoryName = business
  ? (allCategories.find((c) => c.id === business.category)?.data.name ??
    'Uncategorized')
  : '';
---

<BaseLayout
  title="Dashboard"
  description="Manage your Edmonton Home Services listing."
  noindex={true}
>
  <section class="max-w-2xl mx-auto my-16">
    <h1 class="text-3xl font-bold mb-6">Dashboard</h1>

    <div class="form-card mb-6">
      <p class="text-(--text-dim) mt-0 mb-4">
        Logged in as <strong class="text-(--text)">{user!.email}</strong>
      </p>
      <button
        id="logout-button"
        type="button"
        class="btn-accent text-white border-0"
      >
        Log out
      </button>
      <p
        id="logout-error"
        class="mt-2 mb-0 text-sm hidden"
        role="status"
        aria-live="polite"
        style="color: var(--danger)"
      ></p>
    </div>

    {
      business && business.approved ? (
        <>
          <div id="listing-view" class="form-card listing-view">
            <div class="listing-view-head">
              <h1 class="listing-view-name" data-view="name">
                {business.name}
              </h1>
              <button
                id="edit-listing-button"
                type="button"
                class="btn-secondary shrink-0"
              >
                Edit Listing
              </button>
            </div>

            <div class="listing-view-meta">
              <span class="service-chip" data-view="category">
                {categoryName}
              </span>
              <span
                class={`listing-view-neighborhood${business.neighborhood ? '' : ' hidden'}`}
                data-view="neighborhood"
              >
                {business.neighborhood}
              </span>
            </div>

            <hr class="listing-view-divider" />

            <div class="listing-view-body">
              <div>
                <h2 class="listing-view-label">About the Business</h2>
                <p class="listing-view-description" data-view="description">
                  {business.description || 'No description yet.'}
                </p>
                <span
                  id="listing-view-licensed"
                  class={`badge-licensed${business.licensed_insured ? '' : ' hidden'}`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 13c0 5-3.5 7.5-7.35 8.95a1 1 0 0 1-.6.05C8.5 20.5 5 18 5 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C15.51 3.79 18 5 20 5a1 1 0 0 1 1 1z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                  Licensed &amp; Insured
                </span>
              </div>

              <div class="listing-contact-panel">
                <dl class="listing-contact-list">
                  <div>
                    <dt>Phone</dt>
                    <dd data-view="phone">{business.phone || '—'}</dd>
                  </div>
                  <div>
                    <dt>Website</dt>
                    <dd data-view="website">{business.website || '—'}</dd>
                  </div>
                  <div>
                    <dt>Hours</dt>
                    <dd data-view="hours">{business.hours || '—'}</dd>
                  </div>
                  <div>
                    <dt>Years in Business</dt>
                    <dd data-view="years">
                      {business.years_in_business ?? '—'}
                    </dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>

          <div id="listing-edit" class="form-card hidden">
            <h2 class="mt-0 mb-1">Edit Listing</h2>
            <p class="text-(--text-dim) mt-0 mb-4">
              Update your public profile information.
            </p>
            <hr class="listing-view-divider mb-5" />

            {/*
              onsubmit as a plain inline HTML attribute, not left solely to
              the module <script> below to attach via addEventListener. It
              runs even if that script fails to load for some reason (a
              Vite/CDN hiccup, an ad blocker, etc.) — belt-and-suspenders so
              a broken script degrades to "the button does nothing" instead
              of leaking every field into the URL via a native GET submit.
            */}
            <form id="edit-form" onsubmit="event.preventDefault()" novalidate>
              <input type="hidden" name="id" value={business.id} />

              <label for="name">
                Business Name
                <input
                  type="text"
                  name="name"
                  id="name"
                  value={business.name}
                  required
                />
              </label>
              <p
                id="name-error"
                class="field-error mt-1 mb-0 text-sm hidden"
                style="color: var(--danger)"
              ></p>

              <div class="form-row">
                <label for="category">
                  Category
                  <select name="category" id="category" required>
                    <option value="" disabled selected={!business.category}>
                      Select a category
                    </option>
                    {allCategories.map((c) => (
                      <option
                        value={c.id}
                        selected={c.id === business.category}
                      >
                        {c.data.name}
                      </option>
                    ))}
                  </select>
                </label>

                <label for="neighborhood">
                  Neighborhood / Base
                  <input
                    type="text"
                    name="neighborhood"
                    id="neighborhood"
                    value={business.neighborhood ?? ''}
                    placeholder="e.g. Strathcona"
                  />
                </label>
              </div>
              <p
                id="category-error"
                class="field-error mt-1 mb-0 text-sm hidden"
                style="color: var(--danger)"
              ></p>

              <div class="form-row">
                <label for="phone">
                  Phone Number
                  <input
                    type="tel"
                    name="phone"
                    id="phone"
                    value={business.phone ?? ''}
                    placeholder="780-555-0123"
                    pattern="[0-9+\(\)\-. ]+"
                    title="Numbers only, e.g. 780-555-0123"
                  />
                </label>

                <label for="website">
                  Website
                  <input
                    type="text"
                    name="website"
                    id="website"
                    value={business.website ?? ''}
                    placeholder="https://example.com"
                    pattern="(https?://)?([-\w]+\.)+[a-zA-Z]{2,}(/\S*)?"
                    title="Enter a domain, e.g. example.com or https://example.com"
                    required
                  />
                </label>
              </div>
              <div class="form-row">
                <p
                  id="phone-error"
                  class="field-error mt-1 mb-0 text-sm hidden"
                  style="color: var(--danger)"
                ></p>
                <p
                  id="website-error"
                  class="field-error mt-1 mb-0 text-sm hidden"
                  style="color: var(--danger)"
                ></p>
              </div>

              <div class="form-row">
                <label for="hours">
                  Hours of Operation
                  <input
                    type="text"
                    name="hours"
                    id="hours"
                    value={business.hours ?? ''}
                    placeholder="e.g. Mon-Fri 8am-5pm"
                  />
                </label>

                <label for="years_in_business">
                  Years in Business
                  <input
                    type="number"
                    name="years_in_business"
                    id="years_in_business"
                    value={business.years_in_business ?? ''}
                    min="0"
                  />
                </label>
              </div>

              <label for="description">
                Description
                <textarea name="description" id="description" rows="5">{business.description ?? ''}</textarea>
              </label>

              <label class="check">
                <input
                  type="checkbox"
                  name="licensed_insured"
                  checked={business.licensed_insured}
                />
                <span>Licensed &amp; insured</span>
              </label>

              <div class="listing-edit-actions">
                <button
                  type="submit"
                  id="save-button"
                  class="btn-accent text-white border-0"
                >
                  Save changes
                </button>
                <button type="button" id="cancel-edit-button" class="btn-secondary">
                  Cancel
                </button>
              </div>
            </form>

            <p
              id="save-status"
              class="mt-4 mb-0 text-sm hidden"
              role="status"
              aria-live="polite"
            />
          </div>
        </>
      ) : business && !business.approved ? (
        <>
          <div class="notice-banner">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <p class="m-0">
              Your listing is under review — we'll notify you once it's
              approved and live on the site.
            </p>
          </div>

          <div class="form-card listing-view is-pending">
            <div class="listing-view-head">
              <h1 class="listing-view-name">{business.name}</h1>
            </div>

            <div class="listing-view-meta">
              <span class="service-chip">{categoryName}</span>
              {business.neighborhood && (
                <span class="listing-view-neighborhood">
                  {business.neighborhood}
                </span>
              )}
            </div>

            <hr class="listing-view-divider" />

            <div class="listing-view-body">
              <div>
                <h2 class="listing-view-label">About the Business</h2>
                <p class="listing-view-description">
                  {business.description || 'No description yet.'}
                </p>
                {business.licensed_insured && (
                  <span class="badge-licensed">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 13c0 5-3.5 7.5-7.35 8.95a1 1 0 0 1-.6.05C8.5 20.5 5 18 5 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C15.51 3.79 18 5 20 5a1 1 0 0 1 1 1z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                    Licensed &amp; Insured
                  </span>
                )}
              </div>

              <div class="listing-contact-panel">
                <dl class="listing-contact-list">
                  <div>
                    <dt>Phone</dt>
                    <dd>{business.phone || '—'}</dd>
                  </div>
                  <div>
                    <dt>Website</dt>
                    <dd>{business.website || '—'}</dd>
                  </div>
                  <div>
                    <dt>Hours</dt>
                    <dd>{business.hours || '—'}</dd>
                  </div>
                  <div>
                    <dt>Years in Business</dt>
                    <dd>{business.years_in_business ?? '—'}</dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </>
      ) : error ? (
        <div class="notice-card">
          <div class="notice-icon notice-icon--warning">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
          </div>
          <h2 class="notice-card-title">
            Something went wrong loading your business
          </h2>
          <p class="notice-card-desc">
            We encountered a temporary issue while fetching your profile
            data. Please try again or contact support if the issue persists.
          </p>
          <div class="notice-card-actions">
            <button type="button" id="retry-button" class="btn-primary">
              Retry
            </button>
            <a href={href('contact')} class="btn-dark">
              Contact Support
            </a>
          </div>
        </div>
      ) : (
        <div class="notice-card">
          <div class="notice-icon notice-icon--info">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
          </div>
          <h2 class="notice-card-title">
            No business is linked to this account yet.
          </h2>
          <p class="notice-card-desc">
            Get started by adding your business to the Edmonton Home Services
            directory to reach local homeowners.
          </p>
          <div class="notice-card-actions">
            <a href={href('submit-business')} class="btn-accent text-white">
              Submit a Business
            </a>
          </div>
          <p class="notice-card-footnote">
            Already have a listing?{' '}
            <a href={href('contact')} class="text-(--primary) hover:opacity-80">
              Contact us
            </a>{' '}
            to get it linked.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import { validateForm, clearFieldErrorOnInput } from '../../lib/form-errors';

  const base = import.meta.env.BASE_URL;

  // Loaded lazily inside each handler rather than as a static top-level
  // import: if this module fails to load (a stale dev-server dependency
  // cache, a blocked script, etc.), a static import would have silently
  // broken this entire file before either addEventListener below ever
  // attached — both buttons would just do nothing. Repeated calls resolve
  // from the browser's module cache once a load succeeds, so this doesn't
  // re-fetch anything on every click.
  async function getSupabase() {
    const { createSupabaseBrowserClient } = await import(
      '../../lib/supabase-browser'
    );
    return createSupabaseBrowserClient();
  }

  const logoutButton = document.getElementById(
    'logout-button',
  ) as HTMLButtonElement;
  const logoutError = document.getElementById(
    'logout-error',
  ) as HTMLParagraphElement | null;

  logoutButton.addEventListener('click', async () => {
    logoutButton.disabled = true;
    logoutButton.textContent = 'Logging out…';
    logoutError?.classList.add('hidden');

    let supabase;
    try {
      supabase = await getSupabase();
    } catch (moduleError) {
      console.error('Failed to load the Supabase client:', moduleError);
      logoutButton.disabled = false;
      logoutButton.textContent = 'Log out';
      if (logoutError) {
        logoutError.textContent =
          "Couldn't log out — please refresh the page and try again.";
        logoutError.classList.remove('hidden');
      }
      return;
    }

    // Clears the session both from the browser's in-memory state and from
    // the sb-* cookies it's stored in — the same cookies middleware.ts
    // reads on the server, so the next /dashboard request will correctly
    // find no session and bounce to /login on its own.
    await supabase.auth.signOut();

    window.location.href = `${base}login`.replace(/\/+/g, '/');
  });

  // Retry button — the error state's only escape hatch, matching what the
  // old inline copy told visitors to do ("try refreshing"). A fresh
  // navigation re-runs the maybeSingle() query server-side, so this is all
  // it needs to do.
  document.getElementById('retry-button')?.addEventListener('click', () => {
    window.location.reload();
  });

  // ---------------------------------------------------------------- view/edit
  // The approved-business state shows a read-only view card by default
  // (#listing-view) and the pre-existing edit form (#listing-edit, hidden
  // until requested) — a purely client-side toggle. Neither branch changes
  // what's queried server-side or how the save request works.
  const listingView = document.getElementById('listing-view');
  const listingEdit = document.getElementById('listing-edit');
  const editListingButton = document.getElementById('edit-listing-button');
  const cancelEditButton = document.getElementById('cancel-edit-button');

  const editForm = document.getElementById(
    'edit-form',
  ) as HTMLFormElement | null;
  const saveButton = document.getElementById(
    'save-button',
  ) as HTMLButtonElement | null;
  const saveStatus = document.getElementById(
    'save-status',
  ) as HTMLParagraphElement | null;

  function showEdit() {
    listingView?.classList.add('hidden');
    listingEdit?.classList.remove('hidden');
  }

  function showView() {
    listingEdit?.classList.add('hidden');
    listingView?.classList.remove('hidden');
  }

  editListingButton?.addEventListener('click', showEdit);

  cancelEditButton?.addEventListener('click', () => {
    editForm?.reset();
    editForm
      ?.querySelectorAll('.field-error')
      .forEach((el) => el.classList.add('hidden'));
    saveStatus?.classList.add('hidden');
    showView();
  });

  // Mirrors the saved form values into the view card's text nodes so the
  // view the visitor lands back on matches what they just saved, without a
  // full page reload.
  function syncViewFromForm(form: HTMLFormElement) {
    if (!listingView) return;
    const get = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';

    const setText = (field: string, value: string) => {
      const el = listingView.querySelector(`[data-view="${field}"]`);
      if (el) el.textContent = value;
    };

    setText('name', get('name'));
    setText('phone', get('phone') || '—');
    setText('website', get('website') || '—');
    setText('hours', get('hours') || '—');
    setText(
      'years',
      get('years_in_business') ? get('years_in_business') : '—',
    );
    setText('description', get('description') || 'No description yet.');

    const categorySelect = form.elements.namedItem(
      'category',
    ) as HTMLSelectElement | null;
    setText('category', categorySelect?.selectedOptions[0]?.text ?? '');

    const neighborhoodEl = listingView.querySelector(
      '[data-view="neighborhood"]',
    );
    const neighborhood = get('neighborhood');
    if (neighborhoodEl) {
      neighborhoodEl.textContent = neighborhood;
      neighborhoodEl.classList.toggle('hidden', !neighborhood);
    }

    const licensedEl = document.getElementById('listing-view-licensed');
    const licensedInput = form.elements.namedItem(
      'licensed_insured',
    ) as HTMLInputElement | null;
    licensedEl?.classList.toggle('hidden', !licensedInput?.checked);
  }

  editForm
    ?.querySelectorAll('input, select, textarea')
    .forEach((field) =>
      clearFieldErrorOnInput(
        field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      ),
    );

  function showSaveStatus(message: string, isError: boolean) {
    if (!saveStatus) return;
    saveStatus.textContent = message;
    saveStatus.classList.remove('hidden');
    saveStatus.style.color = isError ? 'var(--danger)' : 'var(--primary)';
  }

  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!saveButton) return;
    saveStatus?.classList.add('hidden');

    if (!validateForm(editForm)) return;

    const formData = new FormData(editForm);
    const id = formData.get('id')?.toString();
    if (!id) return;

    const yearsRaw = formData.get('years_in_business')?.toString().trim();

    saveButton.disabled = true;
    const originalLabel = saveButton.textContent;
    saveButton.textContent = 'Saving…';

    let supabase;
    try {
      supabase = await getSupabase();
    } catch (moduleError) {
      console.error('Failed to load the Supabase client:', moduleError);
      saveButton.disabled = false;
      saveButton.textContent = originalLabel;
      showSaveStatus(
        "Couldn't load the dashboard's save function. Please refresh the page and try again.",
        true,
      );
      return;
    }

    // update(), not insert() — this row already exists (that's what
    // maybeSingle() found server-side). Sent through the browser client,
    // never the service_role key, so the ONLY thing standing between this
    // request and writing to someone else's business is the "Owners
    // update own listing" row-level security policy on the businesses
    // table matching owner_id against the logged-in user — same
    // enforcement whether this code is honest about it or not.
    //
    // .select() on the end matters: Supabase's update() can come back with
    // error === null and an empty data array when RLS silently matches
    // zero rows — that's a real failure (nothing was written), but without
    // .select() there'd be no way to tell it apart from a genuine success,
    // since neither one produces an error.
    const { data, error } = await supabase
      .from('businesses')
      .update({
        name: formData.get('name')?.toString().trim(),
        category: formData.get('category')?.toString() || null,
        neighborhood: formData.get('neighborhood')?.toString().trim() || null,
        phone: formData.get('phone')?.toString().trim() || null,
        website: formData.get('website')?.toString().trim(),
        description: formData.get('description')?.toString().trim() || null,
        hours: formData.get('hours')?.toString().trim() || null,
        years_in_business: yearsRaw ? Number(yearsRaw) : null,
        licensed_insured: formData.get('licensed_insured') === 'on',
      })
      .eq('id', id)
      .select();

    saveButton.disabled = false;
    saveButton.textContent = originalLabel;

    if (error) {
      // Postgres error code 42501 = insufficient_privilege, which is what
      // a row-level security policy rejection surfaces as — a different,
      // more actionable situation for the visitor than a generic failure.
      if (error.code === '42501') {
        showSaveStatus(
          "We couldn't save your changes due to a permissions issue on our end. Please contact us so we can help.",
          true,
        );
      } else {
        showSaveStatus(`Couldn't save your changes: ${error.message}`, true);
      }
    } else if (!data || data.length === 0) {
      showSaveStatus(
        "Couldn't save your changes — no matching row was updated. " +
          "That usually means a permissions rule blocked the write rather " +
          'than the save request itself failing.',
        true,
      );
    } else {
      showSaveStatus('Saved.', false);
      syncViewFromForm(editForm);
      window.setTimeout(showView, 900);
    }
  });
</script>

<style>
  /* ------------------------------------------------------- listing view card */
  .listing-view-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .listing-view-name {
    margin: 0;
    font-size: 28px;
    color: var(--heading);
  }
  .is-pending .listing-view-name {
    color: var(--text-dim);
  }
  .listing-view-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .listing-view-neighborhood {
    color: var(--text-dim);
    font-size: 14px;
  }
  .listing-view-divider {
    margin: 18px 0;
    border: none;
