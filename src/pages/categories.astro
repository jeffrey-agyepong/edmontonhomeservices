---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBox from '../components/CategoryBox.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getPopulatedCategories } from '../lib/categories';

const base = import.meta.env.BASE_URL;

/*
 * Deliberately no <Sponsors /> section on this page. That component sells
 * ad slots against a specific category's search intent (4 slots on the
 * homepage, 2 on a single category page like /c/roofing-roof-repair) — this
 * "all categories" overview isn't scoped to any one category, so there's
 * nothing specific to sell an ad against here. Zero slots, not a smaller
 * generic version.
 *
 * Same reasoning applies to the category cards below: this is a directory
 * of categories, not of businesses, so no individual company is named here
 * either — just each category's name and how many listings it has. See
 * CategoryBox.astro.
 */

const populated = await getPopulatedCategories();
const sections = populated.map(({ category, listings }) => ({
  category,
  total: listings.length,
}));
---

<BaseLayout
  title="Categories"
  description="Browse the full Edmonton Home Services directory by category."
>
  <section
    class="full-bg bg-emerald-800 text-(--bg) px-4 py-8 sm:py-10 md:py-14 mb-10 sm:mb-16 border-b-4 border-red-400"
  >
    <Breadcrumbs
      variant="hero"
      items={[{ label: 'Home', href: base }, { label: 'Categories' }]}
    />
    <h1
      class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 sm:mb-4 text-center text-white"
    >
      All Service Categories
    </h1>
    <p
      class="page-head-desc text-base sm:text-lg md:text-xl max-w-2xl flex justify-center mx-auto text-center text-white"
    >
      Browse our complete directory of Edmonton's best home service
      professionals, meticulously vetted by locals.
    </p>
  </section>

  {
    sections.length === 0 ? (
      <p class="landing-meta">
        Nothing here yet. Add JSON files under{' '}
        <code>src/content/listings/</code>.
      </p>
    ) : (
      <div class="category-grid mb-8">
        {sections.map((s) => (
          <CategoryBox category={s.category} total={s.total} />
        ))}
      </div>
    )
  }
</BaseLayout>
