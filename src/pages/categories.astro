---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryBox from '../components/CategoryBox.astro';
import { sortListings } from '../lib/sort';
import { getPopulatedCategories } from '../lib/categories';
import { PER_CATEGORY } from '../consts';

const populated = await getPopulatedCategories();
const sections = populated.map(({ category, listings }) => {
  const mine = sortListings(listings, 'top');
  return {
    category,
    listings: mine.slice(0, PER_CATEGORY),
    total: mine.length,
  };
});
---

<BaseLayout
  title="Categories"
  description="Browse the full Edmonton Home Services directory by category."
>
  <section
    class="full-bg bg-emerald-800 text-(--bg) px-4 py-8 sm:py-10 md:py-14 mb-10 sm:mb-16 border-b-4 border-red-400"
  >
    <h1
      class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 sm:mb-4 text-center text-white"
    >
      All Service Categories
    </h1>
    <p
      class="page-head-desc text-base sm:text-lg md:text-xl max-w-2xl flex justify-center mx-auto text-center text-white"
    >
      Browse our complete directory of Edmonton's best home service
      professionals, meticulously vetted by locals.
    </p>
  </section>

  {
    sections.length === 0 ? (
      <p class="landing-meta">
        Nothing here yet. Add JSON files under{' '}
        <code>src/content/listings/</code>.
      </p>
    ) : (
      <div class="category-grid mb-8">
        {sections.map((s) => (
          <CategoryBox
            category={s.category}
            listings={s.listings}
            total={s.total}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
