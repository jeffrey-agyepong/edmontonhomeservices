---
/*
 * This renders a real premium business card. Currently disabled because no
 * business has purchased a sponsored spot yet, so all slots show as available.
 * To re-enable: uncomment this block and wire it back to pull businesses
 * where premium=true.
 *
 * import { getCollection } from 'astro:content';
 * import { placeholderGradient } from '../../lib/placeholder';
 * import Rating from '../Rating.astro';
 */

interface Props {
  // Set on category pages so the "available" copy reads naturally
  // ("... searching for Roofing services" instead of the generic homepage
  // phrasing). Leave unset on the homepage.
  categoryName?: string;
  // The category's id/slug (e.g. "roofing-roof-repair"). Not used yet since
  // real ad rendering is disabled, but a category page's ads should only
  // ever show businesses from that same category once re-enabled — see the
  // commented-out fetch logic below for how this plugs in.
  categoryId?: string;
}

const { categoryName, categoryId } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

/*
 * This renders a real premium business card. Currently disabled because no
 * business has purchased a sponsored spot yet, so all slots show as available.
 * To re-enable: uncomment this block and wire it back to pull businesses
 * where premium=true.
 *
 * const listingHref = (slug: string) => `${base}l/${slug}`.replace(/\/+/g, '/');
 *
 * const [listings, categories] = await Promise.all([
 *   getCollection('listings'),
 *   getCollection('categories'),
 * ]);
 *
 * const sponsors = listings
 *   .filter(
 *     (l) =>
 *       l.data.sponsored && (!categoryId || l.data.category === categoryId),
 *   )
 *   .map((listing) => ({
 *     listing,
 *     category: categories.find((c) => c.id === listing.data.category) ?? null,
 *   }));
 */

// The homepage shows 4 open slots; a single category page only shows 2 —
// there's less sponsorable inventory to sell on any one category.
const AVAILABLE_SLOTS = categoryName ? 2 : 4;
const serviceLabel = categoryName
  ? `${categoryName} services`
  : 'home service needs';
---

<section
  class="sponsors relative left-1/2 right-1/2 mx-[-50vw] w-screen bg-(--panel) py-10"
>
  <div class="wrap">
    <div class="sponsors-header">
      <div class="sponsors-heading">
        <span class="sponsors-badge">Sponsored</span>
        <h2 class="sponsors-title">Local Spotlight</h2>
        <p class="sponsors-subtitle">
          Support the businesses that support our community.
        </p>
      </div>
      <a class="sponsors-cta" href={href('advertise')}>
        Advertise your business here &rarr;
      </a>
    </div>

    <div class="sponsor-grid">
      <!--
        This renders a real premium business card. Currently disabled
        because no business has purchased a sponsored spot yet, so all
        slots show as available. To re-enable: uncomment this block and
        wire it back to pull businesses where premium=true.

        {sponsors.map(({ listing, category }) => {
          const d = listing.data;
          return (
            <article class="sponsor-card">
              <div class="sponsor-media">
                {d.photo ? (
                  <img src={d.photo} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div
                    class="sponsor-media-placeholder"
                    style={`background:${placeholderGradient(listing.id)}`}
                  >
                    <span>{d.name.charAt(0)}</span>
                  </div>
                )}
              </div>
              <div class="sponsor-body">
                <div class="sponsor-top-row">
                  <div class="sponsor-meta">
                    {category && (
                      <span class="sponsor-category">
                        {category.data.name}
                      </span>
                    )}
                    <Rating
                      rating={d.google_rating}
                      count={d.google_review_count}
                      showCount={true}
                    />
                  </div>
                  <span class="sponsor-ad-badge">AD</span>
                </div>

                <h3 class="sponsor-name">{d.name}</h3>

                {d.description && (
                  <p class="sponsor-description">{d.description}</p>
                )}

                <a class="sponsor-button" href={listingHref(listing.id)}>
                  View Profile
                </a>
              </div>
            </article>
          );
        })}
      -->

      {
        Array.from({ length: AVAILABLE_SLOTS }).map(() => (
          <article class="sponsor-card sponsor-card--available">
            <div class="sponsor-media sponsor-media--available">
              <span class="sponsor-available-icon" aria-hidden="true">
                +
              </span>
            </div>
            <div class="sponsor-body">
              <div class="sponsor-top-row">
                <span class="sponsor-available-badge">Spot Available</span>
              </div>

              <h3 class="sponsor-name sponsor-name--available">
                Your Business Here
              </h3>

              <p class="sponsor-description sponsor-available-text">
                Feature your business here and get seen by Edmonton homeowners
                searching for {serviceLabel}.
              </p>

              <a
                class="sponsor-button sponsor-button--available"
                href={href('advertise')}
              >
                Claim This Spot &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Structure only: no color, type, or decoration here on purpose. */

  .sponsors-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .sponsors-badge {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid var(--line);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sponsors-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0.25rem 0 0;
  }
  .sponsors-subtitle {
    font-size: 1.25rem;
    margin: 0.25rem 0 0;
  }

  .sponsor-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .sponsor-ad-badge {
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid var(--line);
    padding: 0.25rem 0.5rem;
  }
  .sponsor-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sponsor-category {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
    background: var(--panel-head);
    border-radius: 9999px;
    padding: 0.25rem 0.65rem;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .sponsor-grid {
      grid-template-columns: 1fr;
    }
  }

  .sponsor-card {
    display: flex;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .sponsor-media {
    flex: 0 0 40%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .sponsor-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sponsor-media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sponsor-media-placeholder span {
    font-size: 2.5rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.9);
  }

  .sponsor-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1rem;
  }

  .sponsor-name {
    margin: 0;
    font-size: 1.5rem;
  }

  .sponsor-description {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sponsor-button {
    display: inline-block;
    margin-top: auto;
    text-align: center;
    width: 100%;
    background: var(--accent);
    color: #fff;
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    font-weight: 500;
    text-decoration: none;
  }

  /* "Spot available" placeholder: same media+body layout, grid and
     card dimensions as a real sponsor-card, styled distinctly (dashed
     border, muted fill) so it reads as open inventory rather than
     broken/missing content. */
  .sponsor-card--available {
    border-style: dashed;
  }
  .sponsor-media--available {
    background: var(--panel-head);
    border-right: 1px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sponsor-available-icon {
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--text-dim);
  }
  .sponsor-available-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 9999px;
    padding: 0.25rem 0.65rem;
  }
  .sponsor-name--available {
    color: var(--text-dim);
    font-style: italic;
  }
  .sponsor-available-text {
    color: var(--text-dim);
    -webkit-line-clamp: 3;
  }
  .sponsor-button--available {
    width: auto;
    align-self: flex-start;
    background: var(--accent);
    color: white;
  }

  @media (max-width: 640px) {
    .sponsors-title {
      font-size: 1.5rem;
    }

    .sponsors-subtitle {
      font-size: 1rem;
    }

    .sponsor-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .sponsor-card {
      flex-direction: column;
    }

    .sponsor-media {
      flex: 0 0 auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
