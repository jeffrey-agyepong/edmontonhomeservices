---
import { getCollection } from 'astro:content';
import { placeholderGradient } from '../../lib/placeholder';
import Rating from '../Rating.astro';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');
const listingHref = (slug: string) => `${base}l/${slug}`.replace(/\/+/g, '/');

const [listings, categories] = await Promise.all([
  getCollection('listings'),
  getCollection('categories'),
]);

// Only listings a business has actually paid to be sponsored show up here —
// independent of `premium` (that gates the gallery/quote form on the
// listing's own page instead) — and no fallback/demo cards when there are
// none.
const sponsors = listings
  .filter((l) => l.data.sponsored)
  .map((listing) => ({
    listing,
    category: categories.find((c) => c.id === listing.data.category) ?? null,
  }));
---

{
  sponsors.length > 0 && (
    <section class="sponsors relative left-1/2 right-1/2 mx-[-50vw] w-screen bg-(--panel) py-10">
      <div class="wrap">
        <div class="sponsors-header">
          <div class="sponsors-heading">
            <span class="sponsors-badge">Sponsored</span>
            <h2 class="sponsors-title">Local Spotlight</h2>
            <p class="sponsors-subtitle">
              Support the businesses that support our community.
            </p>
          </div>
          <a class="sponsors-cta" href={href('advertise')}>
            Advertise your business here &rarr;
          </a>
        </div>

        <div class="sponsor-grid">
          {sponsors.map(({ listing, category }) => {
            const d = listing.data;
            return (
              <article class="sponsor-card">
                <div class="sponsor-media">
                  {d.photo ? (
                    <img src={d.photo} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <div
                      class="sponsor-media-placeholder"
                      style={`background:${placeholderGradient(listing.id)}`}
                    >
                      <span>{d.name.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <div class="sponsor-body">
                  <div class="sponsor-top-row">
                    <div class="sponsor-meta">
                      {category && (
                        <span class="sponsor-category">
                          {category.data.name}
                        </span>
                      )}
                      <Rating
                        rating={d.google_rating}
                        count={d.google_review_count}
                        showCount={true}
                      />
                    </div>
                    <span class="sponsor-ad-badge">AD</span>
                  </div>

                  <h3 class="sponsor-name">{d.name}</h3>

                  {d.description && (
                    <p class="sponsor-description">{d.description}</p>
                  )}

                  <a class="sponsor-button" href={listingHref(listing.id)}>
                    View Profile
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Structure only — no color, type, or decoration here on purpose. */

  .sponsors-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .sponsors-badge {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid var(--line);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .sponsors-title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0.25rem 0 0;
  }
  .sponsors-subtitle {
    font-size: 1.25rem;
    margin: 0.25rem 0 0;
  }

  .sponsor-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  .sponsor-ad-badge {
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid var(--line);
    padding: 0.25rem 0.5rem;
  }
  .sponsor-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sponsor-category {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
    background: var(--panel-head);
    border-radius: 9999px;
    padding: 0.25rem 0.65rem;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .sponsor-grid {
      grid-template-columns: 1fr;
    }
  }

  .sponsor-card {
    display: flex;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .sponsor-media {
    flex: 0 0 40%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .sponsor-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sponsor-media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sponsor-media-placeholder span {
    font-size: 2.5rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.9);
  }

  .sponsor-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1rem;
  }

  .sponsor-name {
    margin: 0;
    font-size: 1.5rem;
  }

  .sponsor-description {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sponsor-button {
    display: inline-block;
    margin-top: auto;
    text-align: center;
    width: 100%;
    background: var(--primary);
    color: var(--primary-ink);
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .sponsors-title {
      font-size: 1.5rem;
    }

    .sponsors-subtitle {
      font-size: 1rem;
    }

    .sponsor-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .sponsor-card {
      flex-direction: column;
    }

    .sponsor-media {
      flex: 0 0 auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
