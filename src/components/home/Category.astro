---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const listings = await getCollection('listings');
const categories = await getCollection('categories');

// The homepage teaser only spotlights these three; the rest live behind
// "View All Categories" in the full grid further down the page.
const featuredSlugs = ['house-cleaning', 'general-contractors', 'landscaping-lawn-care'];
const featured = featuredSlugs
  .map((slug) => categories.find((c) => c.data.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// No photography yet — each card gets a distinct gradient band with the
// category's initial until real images are ready to drop in.
const imageStyles: Record<string, string> = {
  'house-cleaning': 'linear-gradient(135deg, #3776a5, #5aa9c4)',
  'general-contractors': 'linear-gradient(135deg, #8a5a2b, #c98a4b)',
  'landscaping-lawn-care': 'linear-gradient(135deg, #2f6b3f, #6ea15a)',
};

const cards = featured.map((category) => ({
  category,
  count: listings.filter((l) => l.data.category === category.data.slug).length,
  imageStyle: imageStyles[category.data.slug] ?? 'linear-gradient(135deg, #37765f, #5a9a80)',
}));
---
<section class="relative left-1/2 right-1/2 mx-[-50vw] w-screen bg-(--panel) py-10">
  <div class="wrap">
    <div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-left">
        Explore by Category
      </h2>
      <p class="text-(--text-dim) text-left text-base sm:text-lg md:text-xl">
        Browse our curated directory of top Edmonton home professionals.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-6"
    >
      {cards.map(({ category, count, imageStyle }) => (
        <a
          class="category block overflow-hidden rounded-lg border border-(--line) bg-(--bg) no-underline hover:border-(--primary)"
          href={`${base}c/${category.data.slug}`.replace(/\/+/g, '/')}
        >
          <div
            class="flex aspect-video w-full items-center justify-center"
            style={`background: ${imageStyle}`}
          >
            <span class="text-4xl font-bold text-white/90">{category.data.name.charAt(0)}</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg sm:text-2xl font-medium text-left text-(--text)">{category.data.name}</h3>
            {category.data.description && (
              <p class="text-(--text-dim) text-left text-base sm:text-lg mt-2">
                {category.data.description}
              </p>
            )}
            <p class="text-left text-(--text-dim) text-sm mt-3">
              {count} {count === 1 ? 'provider' : 'providers'}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href={href('#categories')}
        class="inline-flex items-center rounded-full bg-(--primary) px-6 py-3 text-sm font-semibold text-(--bg) no-underline hover:opacity-90"
      >
        View All Categories
      </a>
    </div>
  </div>
</section>
