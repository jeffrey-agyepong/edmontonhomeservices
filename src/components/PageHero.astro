---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs: Crumb[];
  // Raw inline SVG markup (e.g. a category's icon field), shown before the
  // title text.
  icon?: string;
  // The bottom margin that separates this hero from the section below it.
  // Off on the category page, which sits directly against <Sponsors />.
  spaced?: boolean;
}

const {
  title,
  description,
  breadcrumbs,
  icon,
  spaced = true,
} = Astro.props;
---

<section
  class={`full-bg bg-emerald-800 text-(--bg) px-4 py-8 sm:py-10 md:py-14 ${spaced ? 'mb-10 sm:mb-16 ' : ''}border-b-4 border-red-400`}
>
  <Breadcrumbs variant="hero" items={breadcrumbs} />
  <h1
    class="text-4xl sm:text-5xl md:text-6xl font-semibold mb-3 sm:mb-4 text-center text-white"
  >
    {icon && <span class="category-icon" set:html={icon} />}
    {title}
  </h1>
  <p
    class="page-head-desc text-base sm:text-lg md:text-xl max-w-2xl mx-auto text-center text-white"
  >
    {description}
  </p>
</section>
