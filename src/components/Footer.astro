---
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { getPopulatedCategories } from '../lib/categories';

interface Props {
  footerPages: CollectionEntry<'pages'>[];
  href: (p: string) => string;
  base: string;
  submitHref: string;
}

const { footerPages, href, base, submitHref } = Astro.props;

const categories = (await getPopulatedCategories()).map((c) => c.category);
const FOOTER_CATEGORY_LIMIT = 8;
const footerCategories = categories.slice(0, FOOTER_CATEGORY_LIMIT);
---

<footer class="border-t-4 border-green-900 bg-(--bg) pt-8 pb-5">
  <div class="wrap">
    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-[1fr_1.4fr_1fr]"
    >
      <div>
        <a
          class="flex items-center gap-3 no-underline hover:opacity-80"
          href={base}
        >
          <span
            class="flex h-9 items-center rounded-lg px-2.5"
            aria-hidden="true"
          >
            <span
              class="font-(family-name:--font-display) text-lg font-extrabold tracking-tight text-(--primary)"
              >EH</span
            ><span
              class="font-(family-name:--font-display) text-lg font-extrabold tracking-tight text-(--accent)"
              >S</span
            >
          </span>
          <span class="h-6 w-px bg-(--line)" aria-hidden="true"></span>
          <span
            class="font-(family-name:--font-display) text-[19px] font-bold text-(--text)"
            >{SITE_TITLE}</span
          >
        </a>
        <p class="mt-3 max-w-xs text-sm text-(--text-dim)">
          Your trusted local guide to finding vetted, high-quality home service
          professionals in Edmonton, Alberta.
        </p>
      </div>

      {
        categories.length > 0 && (
          <div>
            <h3 class="mt-0 mb-2.5 flex h-9 items-center text-[15px] font-bold text-(--text)">
              Categories
            </h3>
            <ul class="m-0 grid grid-cols-2 gap-x-6 gap-y-1.5 list-none p-0">
              {footerCategories.map((c) => (
                <li>
                  <a
                    class="text-sm text-(--text-dim) no-underline hover:text-(--primary)"
                    href={`${base}c/${c.id}`.replace(/\/+/g, '/')}
                  >
                    {c.data.name}
                  </a>
                </li>
              ))}
              <li>
                <a
                  class="text-sm font-medium text-(--primary) no-underline hover:opacity-80"
                  href={href('categories')}
                >
                  View All Categories
                </a>
              </li>
            </ul>
          </div>
        )
      }

      <div>
        <h3
          class="mt-0 mb-2.5 flex h-9 items-center text-[15px] font-bold text-(--text)"
        >
          Company
        </h3>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            footerPages.map((p) => (
              <li>
                <a
                  class="text-sm text-(--text-dim) no-underline hover:text-(--primary)"
                  href={href(p.id)}
                >
                  {p.data.title}
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="text-sm text-(--text-dim) no-underline hover:text-(--primary)"
              href={href('contact')}
            >
              Contact
            </a>
          </li>
          <li>
            <a
              class="text-sm text-(--text-dim) no-underline hover:text-(--primary)"
              href={submitHref}
            >
              Submit Business
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-6 flex flex-col gap-2 border-t border-(--line) pt-4 text-xs text-(--text-dim) sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="m-0">
        {`© ${new Date().getFullYear()} ${SITE_TITLE}. All rights reserved.`}
      </p>
      <p class="m-0">
        {'Built for YEG. Developed by '}
        <a
          href="https://jawebdesign.ca"
          class="text-(--text-dim) hover:text-(--primary)"
          target="_blank"
          rel="noopener noreferrer"
        >
          J.A Web Design
        </a>
        {'.'}
      </p>
    </div>
  </div>
</footer>
