---
import { ratingParts } from '../lib/sort';

interface Props { rating: number | null }
const { rating } = Astro.props;
const parts = ratingParts(rating);
---
{parts && (
  <span class="rating-text">
    <span class="rating-score-value">
      {parts.whole}<span class="dot">.</span><span class="decimal">{parts.dec}</span>
    </span>
  </span>
)}
