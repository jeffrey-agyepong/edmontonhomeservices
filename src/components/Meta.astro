---
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  canonical: URL;
  noindex: boolean;
  base: string;
}

const { title, description, canonical, noindex, base } = Astro.props;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: (Astro.site ?? canonical).toString(),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#1c1b19" />
<link
  rel="icon"
  type="image/svg+xml"
  href={`${base}favicon.svg`.replace(/\/+/g, '/')}
/>
<script is:inline>
  /* Runs before first paint so the page never flashes the wrong theme.
     Falls back to system preference when nothing is saved yet. */
  (function () {
    var saved = localStorage.getItem('theme');
    var theme =
      saved === 'light' || saved === 'dark'
        ? saved
        : window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Bitter for headings/brand, Inter for body copy and UI — see the
     --font-display / --font-body variables in app.css.

     Loaded async (preload + swap-on-load) rather than a plain <link
     rel="stylesheet">, which is render-blocking — Lighthouse flagged this
     stylesheet as sitting in the critical path (~750ms). This keeps the
     browser fetching it at high priority (same as before) but lets the
     page paint without waiting on it; `media="print"` is a standard trick
     to mark a stylesheet as not render-blocking, then onload flips it to
     "all" once it's actually in. <noscript> covers browsers with JS
     disabled, where onload never fires. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bitter:wght@500;600;700;800&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bitter:wght@500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bitter:wght@500;600;700;800&display=swap"
  />
</noscript>
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_CA" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="sitemap" href={`${base}sitemap-index.xml`.replace(/\/+/g, '/')} />
<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
