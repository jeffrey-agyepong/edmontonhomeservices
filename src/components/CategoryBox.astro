---
interface Props {
  category: {
    id: string;
    data: { name: string; description: string; icon: string };
  };
  total: number;
  wide?: boolean;
}

const { category, total, wide = false } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;
---

<section class={`category-box${wide ? ' category-box--wide' : ''}`}>
  <!--
    Placeholder graphic, not a real photo. Replace with real, local
    Edmonton photography representing this category (a real job site, a
    real listed business, etc.) before launch, consistent with the
    site's no-stock-photography direction. No per-category photo data
    exists yet, so this is decorative only.
  -->
  <div class="category-image-placeholder" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <circle cx="9" cy="9" r="2"></circle>
      <path d="m21 15-5-5L5 21"></path>
    </svg>
  </div>

  <div class="category-header">
    <h2 class="category-title">
      <a href={`${base}c/${category.id}`.replace(/\/+/g, '/')}>
        {c.icon && <span class="category-icon" set:html={c.icon} />}
        {c.name}
      </a>
    </h2>
    {c.description && <p class="category-description">{c.description}</p>}
    {
      total > 0 && (
        <p class="category-provider-count">
          {total} {total === 1 ? 'provider' : 'providers'}
        </p>
      )
    }
  </div>

  {
    total > 0 && (
      <a
        class="view-all-link"
        href={`${base}c/${category.id}`.replace(/\/+/g, '/')}
      >
        View all {total}
        <svg
          class="arrow"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M13.2 5.6 11.8 7l4 4H4v2h11.8l-4 4 1.4 1.4L19.6 12z" />
        </svg>
      </a>
    )
  }
</section>
