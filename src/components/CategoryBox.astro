---
interface Props {
  category: {
    id: string;
    data: { name: string; description: string; image: string };
  };
  total: number;
  wide?: boolean;
}

const { category, total, wide = false } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;

// ImageKit supports on-the-fly resizing via a `?tr=w-<px>` query param, so
// the one URL entered in Keystatic can serve a real srcset instead of one
// fixed-size image to every screen. Any other host is used as-is.
const isImageKit = c.image.includes('ik.imagekit.io');
const imageWidths = [400, 600, 800, 1200];
const imageSrcset = isImageKit
  ? imageWidths.map((w) => `${c.image}?tr=w-${w} ${w}w`).join(', ')
  : undefined;
---

<section class={`category-box${wide ? ' category-box--wide' : ''}`}>
  {
    c.image ? (
      <img
        src={c.image}
        srcset={imageSrcset}
        sizes="(max-width: 620px) 100vw, 330px"
        alt={c.name}
        loading="lazy"
        class="category-image"
      />
    ) : (
      // Placeholder graphic, not a real photo. Replace with a real image
      // via Keystatic (Categories > this category > Card image), consistent
      // with the site's no-stock-photography direction — this only shows
      // up before that's been set.
      <div class="category-image-placeholder" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="9" cy="9" r="2" />
          <path d="m21 15-5-5L5 21" />
        </svg>
      </div>
    )
  }

  <div class="category-header">
    <h2 class="category-title">
      <a href={`${base}c/${category.id}`.replace(/\/+/g, '/')}>{c.name}</a>
    </h2>
    {c.description && <p class="category-description">{c.description}</p>}
    {
      total > 0 && (
        <p class="category-provider-count">
          {total} {total === 1 ? 'provider' : 'providers'}
        </p>
      )
    }
  </div>

  {
    total > 0 && (
      <a
        class="view-all-link"
        href={`${base}c/${category.id}`.replace(/\/+/g, '/')}
      >
        View all {total}
        <svg
          class="arrow"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M13.2 5.6 11.8 7l4 4H4v2h11.8l-4 4 1.4 1.4L19.6 12z" />
        </svg>
      </a>
    )
  }
</section>
