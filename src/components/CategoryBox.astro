---
import ListingRow from './ListingRow.astro';

interface Props {
  category: { data: { name: string; slug: string; description: string; icon: string } };
  listings: any[];
  total: number;
  wide?: boolean;
}

const { category, listings, total, wide = false } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;
---
<section class={`category-box${wide ? ' category-box--wide' : ''}`}>
  <div class="category-header">
    <h2 class="category-title">
      <a href={`${base}c/${c.slug}`.replace(/\/+/g, '/')}>
        {c.icon && <span class="category-icon" set:html={c.icon} />}
        {c.name}
      </a>
    </h2>
    {c.description && <p class="category-description">{c.description}</p>}
  </div>

  <div class="category-sites">
    {listings.length === 0
      ? <p class="category-description">Nothing here yet.</p>
      : listings.map((l, i) => <ListingRow listing={l} rank={i + 1} />)}
  </div>

  {total > listings.length && (
    <a class="view-all-link" href={`${base}c/${c.slug}`.replace(/\/+/g, '/')}>
      View all {total}
      <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.2 5.6 11.8 7l4 4H4v2h11.8l-4 4 1.4 1.4L19.6 12z"/></svg>
    </a>
  )}
</section>
