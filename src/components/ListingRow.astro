---
import Rating from './Rating.astro';
import { COUNT_CLICKS } from '../consts';

interface Props {
  listing: { data: { name: string; slug: string; url: string; description: string; rating: number | null; featured: boolean; favicon: string } };
  rank?: number;
}

const { listing, rank = 0 } = Astro.props;
const d = listing.data;
const initial = d.name.slice(0, 1).toUpperCase();

/*
 * A static site cannot count a click, so the link goes straight out. With a
 * directory API behind it, the visit route counts first and then redirects.
 */
const href = COUNT_CLICKS
  ? `${import.meta.env.DIRECTORY_API?.replace(/\/+$/, '')}/visit/${d.slug}`
  : d.url;
---
<div class={`site-item rank-${rank}`}>
  <a href={`${import.meta.env.BASE_URL}l/${d.slug}`.replace(/\/+/g, '/')} class="site-name-link">
    <div class="left">
      {d.favicon
        ? <img src={d.favicon} alt="" class="site-favicon" width="24" height="24" loading="lazy" decoding="async" />
        : <span class="site-favicon site-favicon--placeholder" aria-hidden="true">{initial}</span>}
      <span class="site-name">{d.name}</span>
      {d.featured && <span class="badge-featured">Featured</span>}
    </div>
    <Rating rating={d.rating} />
  </a>
  {d.description && (
    <div class="site-description floater"><span class="text">{d.description}</span></div>
  )}
</div>
