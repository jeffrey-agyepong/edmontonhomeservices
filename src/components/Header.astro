---
import { SITE_TITLE } from '../consts';

interface Props {
  base: string;
  href: (p: string) => string;
  submitHref: string;
}

const { base, href, submitHref } = Astro.props;
---

<!-- Tailwind-authored navbar (see src/styles/tailwind.css) — the rest of the
     site still runs on app.css, which the README says is shared with the
     PHP/WordPress/Joomla editions. Colours below reference that stylesheet's
     CSS custom properties (not Tailwind's own palette) so the light/dark
     toggle keeps working here exactly as it does everywhere else. -->
<header class="sticky top-0 z-50 bg-(--bg) py-5 shadow-lg">
  <div class="wrap flex items-center gap-6">
    <a
      class="flex items-center gap-3 no-underline hover:opacity-80"
      href={base}
    >
      <span class="flex h-9 items-center rounded-lg px-2.5" aria-hidden="true">
        <span
          class="font-(family-name:--font-display) text-2xl sm:text-lg font-extrabold tracking-tight text-(--heading)"
          >EH</span
        ><span
          class="font-(family-name:--font-display) text-2xl sm:text-lg font-extrabold tracking-tight text-(--accent)"
          >S</span
        >
      </span>
      <span class="hidden sm:block h-6 w-px bg-(--line)" aria-hidden="true"></span>
      <span
        class="font-(family-name:--font-display) sm:text-[19px] font-bold text-(--text) hidden sm:inline-block"
        >{SITE_TITLE}</span
      >
    </a>

    <!-- Nav, CTA and theme toggle travel together as one right-hand group. -->
    <div class="ml-auto flex items-center gap-8">
      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        <a
          class="px-1 py-1 text-[15px] font-medium text-(--text) no-underline hover:text-(--primary)"
          href={base}>Home</a
        >
        <a
          class="px-1 py-1 text-[15px] font-medium text-(--text) no-underline hover:text-(--primary)"
          href={href('categories')}>Categories</a
        >
        <a
          class="px-1 py-1 text-[15px] font-medium text-(--text) no-underline hover:text-(--primary)"
          href={href('about')}>About</a
        >
        <a
          class="px-1 py-1 text-[15px] font-medium text-(--text) no-underline hover:text-(--primary)"
          href={href('advertise')}>Advertise</a
        >
        <a
          class="px-1 py-1 text-[15px] font-medium text-(--text) no-underline hover:text-(--primary)"
          href={href('login')}
          data-auth-link>Business Login</a
        >
      </nav>

      <div class="flex items-center gap-3">
        <a
          class="hidden items-center rounded-full bg-(--panel-head) px-4.5 py-2 text-sm font-semibold text-(--text) no-underline hover:bg-(--panel-hover) md:inline-flex"
          href={submitHref}
        >
          Submit Your Business
        </a>

        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle light and dark theme"
          title="Toggle theme"
        >
          <svg class="icon-sun" viewBox="0 0 20 20" aria-hidden="true"
            ><path
              d="M10 2a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 2zM10 7a3 3 0 100 6 3 3 0 000-6zM15.657 5.404a.75.75 0 10-1.06-1.06l-1.061 1.06a.75.75 0 001.06 1.06l1.06-1.06zM18 10a.75.75 0 01-.75.75h-1.5a.75.75 0 010-1.5h1.5a.75.75 0 01.75.75zM5.404 15.657a.75.75 0 001.06-1.06l-1.06-1.061a.75.75 0 10-1.06 1.06l1.06 1.06zM14.596 15.657a.75.75 0 001.06 0l1.06-1.06a.75.75 0 10-1.06-1.06l-1.06 1.06a.75.75 0 000 1.06zM4 10a.75.75 0 01-.75.75h-1.5a.75.75 0 010-1.5h1.5A.75.75 0 014 10zM5.404 4.343a.75.75 0 10-1.06 1.061l1.06 1.06a.75.75 0 001.061-1.06l-1.06-1.06zM10 15a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5a.75.75 0 01.75-.75z"
            ></path></svg
          >
          <svg class="icon-moon" viewBox="0 0 20 20" aria-hidden="true"
            ><path
              d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
            ></path></svg
          >
        </button>

        <!-- Same markup as the PHP and WordPress editions, so all three look
             identical. <details> keeps it working with no JavaScript at all. -->
        <details class="menu md:hidden" id="c00d-menu">
          <summary class="menu-button" aria-label="Menu" title="Menu">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-burger"
              ><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"></path></svg
            >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-close"
              ><path
                d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7l1.4-1.4L10.6 10.6l6.3-6.3z"
              ></path></svg
            >
          </summary>
          <div class="menu-panel">
            <form
              class="menu-search"
              role="search"
              method="get"
              action={href('search')}
            >
              <input
                type="search"
                name="q"
                placeholder="Search the directory…"
                aria-label="Search"
              />
              <button type="submit">Search</button>
            </form>
            <nav class="menu-links">
              <a href={base}>Home</a>
              <a href={href('categories')}>Categories</a>
              <a href={href('about')}>About</a>
              <a href={href('advertise')}>Advertise</a>
              <a href={href('login')} data-auth-link>Business Login</a>
              <a href={submitHref}>Submit Your Business</a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  /* Progressive enhancement only — the menu opens and closes without this.
     Adds click-outside and Escape-to-close, matching the PHP edition. */
  const menu = document.getElementById(
    'c00d-menu',
  ) as HTMLDetailsElement | null;
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) menu.open = false;
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'light'
          ? 'dark'
          : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }

  // Every page (except /dashboard) is static HTML baked at build time, so
  // there's no per-request server to ask "is this visitor logged in?" —
  // that's only possible client-side, after the page has already painted
  // with the logged-out "Business Login" label. getSession() (not
  // getUser()) deliberately: this is cosmetic, not a security gate — the
  // real gate is middleware.ts's getUser() check on /dashboard itself — so
  // it's fine to trust the locally-stored session without a round trip to
  // Supabase's Auth server, which keeps this swap as fast as possible.
  const base = import.meta.env.BASE_URL;
  const authLinks =
    document.querySelectorAll<HTMLAnchorElement>('[data-auth-link]');
  if (authLinks.length > 0) {
    import('../lib/supabase-browser')
      .then(({ createSupabaseBrowserClient }) =>
        createSupabaseBrowserClient().auth.getSession(),
      )
      .then(({ data: { session } }) => {
        if (!session) return;
        const dashboardHref = `${base}dashboard`.replace(/\/+/g, '/');
        authLinks.forEach((link) => {
          link.textContent = 'Dashboard';
          link.href = dashboardHref;
        });
      })
      .catch((error) => {
        // Not logged in vs. couldn't check are indistinguishable to the
        // visitor either way — leave the link reading "Business Login" and
        // move on rather than surfacing an error for a cosmetic check.
        console.error('Failed to check login state for nav:', error);
      });
  }
</script>
