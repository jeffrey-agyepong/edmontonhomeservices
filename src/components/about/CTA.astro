---
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/+/g, '/');
---

<section class="wrap py-14 md:py-20 text-center">
  <h2
    class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-[var(--primary)]"
  >
    Are you a highly-rated Edmonton business?
  </h2>
  <p
    class="text-(--text-dim) text-base sm:text-lg md:text-xl max-w-2xl mx-auto mb-8"
  >
    Join our curated directory and connect with homeowners looking for
    quality work they can trust.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-4">
    <a
      href={href('submit-business')}
      class="rounded-lg bg-[var(--primary)] px-8 py-3 font-semibold text-white hover:opacity-90"
    >
      Claim Your Listing
    </a>
    <a
      href={href('contact')}
      class="rounded-lg bg-(--panel-head) px-8 py-3 font-semibold text-(--text) hover:bg-(--panel-hover)"
    >
      Contact Us
    </a>
  </div>
</section>
