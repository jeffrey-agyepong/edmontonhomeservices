---
import type { CollectionEntry } from 'astro:content';
import Rating from '../Rating.astro';

interface Props {
  listing: CollectionEntry<'listings'>;
  categoryName: string;
}

const { listing, categoryName } = Astro.props;
const d = listing.data;
const base = import.meta.env.BASE_URL;
const href = `${base}l/${listing.id}`.replace(/\/+/g, '/');

// Every card carries its own filterable facts as data attributes, so the
// client-side script in CategoryListings.astro can filter/sort by reading
// the rendered DOM directly instead of needing the listing data serialized
// into JSON for it separately.
const servicesAttr = d.services.join('|');
const ratingAttr = d.google_rating ?? -1;
---

<div
  class="listing-card flex flex-col rounded-xl border border-(--line) bg-(--bg) overflow-hidden shadow-lg"
  data-listing-card
  data-name={d.name}
  data-neighborhood={d.neighborhood || ''}
  data-services={servicesAttr}
  data-rating={ratingAttr}
  data-premium={d.premium ? '1' : '0'}
>
  <a href={href} class="block no-underline" tabindex="-1" aria-hidden="true">
    <div class="aspect-[4/3] w-full overflow-hidden bg-(--panel-head)">
      {
        d.photo ? (
          <img
            src={d.photo}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--text-dim)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-10 w-10"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="9" cy="9" r="2" />
              <path d="m21 15-5-5L5 21" />
            </svg>
          </div>
        )
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <span
      class="inline-block self-start rounded-full bg-(--panel-head) px-2.5 py-0.5 text-xs font-medium text-(--text-dim)"
    >
      {categoryName}
    </span>

    <h3 class="mt-0 mb-0 text-lg font-semibold text-(--text)">
      <a href={href} class="text-(--text) hover:text-(--primary)">
        {d.name}
      </a>
    </h3>

    {d.neighborhood && (
      <p class="mt-0 mb-0 text-sm text-(--text-dim)">{d.neighborhood}</p>
    )}

    {d.google_rating !== null && (
      <Rating rating={d.google_rating} count={d.google_review_count} showCount />
    )}

    <a
      href={href}
      class="mt-auto inline-block rounded-lg bg-(--panel-head) px-3 py-2 text-center text-sm font-semibold text-(--text) no-underline hover:bg-(--panel-hover)"
    >
      View Profile
    </a>
  </div>
</div>
