---
import '../styles/tailwind.css';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, COUNT_CLICKS } from '../consts';
import Meta from '../components/Meta.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const pageDesc = description || SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const base = import.meta.env.BASE_URL;

/** Join onto the base path without ever producing a double slash. */
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

/*
 * "Submit Your Business" needs somewhere to write to, same constraint as the
 * outbound listing links (see ListingRow.astro). With a directory API behind
 * the site, send people to its submission form; in local-JSON mode, submissions
 * go to the static Netlify-forms page instead (see submit-business.astro).
 */
const submitHref = COUNT_CLICKS
  ? `${import.meta.env.DIRECTORY_API?.replace(/\/+$/, '')}/submit`
  : href('submit-business');

// About, privacy, terms — whatever this directory has. Sorted the way the
// admin ordered them, so the static build matches the PHP site's footer.
const pages = (await getCollection('pages')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const footerPages = pages.filter((p) => p.data.inFooter);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Meta
      title={pageTitle}
      description={pageDesc}
      canonical={canonical}
      noindex={noindex}
      base={base}
    />
  </head>
  <body>
    <Header base={base} href={href} submitHref={submitHref} />

    <main class="wrap">
      <slot />
    </main>

    <Footer
      footerPages={footerPages}
      href={href}
      base={base}
      submitHref={submitHref}
    />
  </body>
</html>
